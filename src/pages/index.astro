---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Goal from '../components/Goal.astro';
import Menu from '../components/Menu.astro';
import Team from '../components/Team.astro';
import Gallery from '../components/Gallery.astro';
import Contact from '../components/Contact.astro';
import FindUs from '../components/FindUs.astro';
import Footer from '../components/Footer.astro';
import { defaultLocale } from '../lib/i18n';

/* Greek is what the server renders; the switcher swaps chrome to English on the
   client. Single page — every section is an anchor target. */
const locale = defaultLocale;
---

<Base locale={locale}>
  <Nav locale={locale} />

  <main id="main">
    <Hero locale={locale} />
    <Goal locale={locale} />
    <Menu locale={locale} />
    <Team locale={locale} />
    <Gallery locale={locale} />
    <Contact locale={locale} />
    <FindUs locale={locale} />
  </main>

  <Footer locale={locale} />
</Base>
