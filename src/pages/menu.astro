---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Menu from '../components/Menu.astro';
import Footer from '../components/Footer.astro';
import { defaultLocale } from '../lib/i18n';

/*
  Its own page rather than an anchor: 98 items across 19 sections, over half the
  site's DOM, and a restaurant needs a URL that IS the menu — for the QR code on
  the table, the Instagram bio and the Google Business Profile menu field.

  Structured data follows the split: the Restaurant graph stays on the homepage
  with hasMenu pointing here, and the Menu graph is emitted here via menuSchema.
*/
const locale = defaultLocale;
---

<Base
  locale={locale}
  titleKey="meta.menuTitle"
  descriptionKey="meta.menuDescription"
  menuSchema
>
  <Nav locale={locale} />

  {/* id="main" is the skip link's target. The footer's "back to top" uses
      href="#top", which needs no element. */}
  <main id="main">
    <Menu locale={locale} />
  </main>

  <Footer locale={locale} />
</Base>
