---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Team from '../components/Team.astro';
import Footer from '../components/Footer.astro';
import { defaultLocale } from '../lib/i18n';
import greyConcrete from '../assets/photos/backgrounds/grunge-gray-cement-textured-background.jpg';

/*
  Its own page because of its height, not its weight: as five alternating rows
  the section measured 3249px at 1366x768 (4.2 viewports) and 4507px on a
  390x844 phone, sitting between Our Goal and From the kitchen. Shortening it
  was the alternative and the client had already declined it — the portrait grid
  that kept it to 1030px put the bios in ~220px columns, about four words a line.

  The heading moved up a level with the section: Team.astro renders an <h1> and
  the member names went h3 -> h2, since h1 -> h3 skips a level. Both are
  class-styled, so nothing moved visually.

  No extra structured data: nothing in schema.org's Restaurant vocabulary
  describes a staff roster usefully, and the bios are prose, not credentials.
*/
const locale = defaultLocale;

/*
  Computed here, not inside Team.astro: a component's frontmatter runs while
  its slot is rendered, which is after Base has already written <head> to the
  stream, so it is too late to preload from there. See preloadImage on Base
  for why this needs to be a preload at all — see .section--concrete-test in
  global.css for the rest of the TEMP concrete-ground story. quality: 60 is a
  deliberate cut from the pipeline's 80 default: this is a noisy texture
  sitting under a 28% tint and mostly under page content, and it halves the
  payload (654KB -> 329KB) with no visible difference at either quality.
*/
const bgTexture = await getImage({ src: greyConcrete, format: 'webp', width: 2560, quality: 60 });
---

<Base
  locale={locale}
  titleKey="meta.teamTitle"
  descriptionKey="meta.teamDescription"
  preloadImage={bgTexture.src}
>
  <Nav locale={locale} />

  {/* id="main" is the skip link's target. The footer's "back to top" uses
      href="#top", which needs no element. */}
  <main id="main">
    <Team locale={locale} bgTexture={bgTexture.src} />
  </main>

  <Footer locale={locale} />
</Base>
