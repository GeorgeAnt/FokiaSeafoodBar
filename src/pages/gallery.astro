---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Gallery from '../components/Gallery.astro';
import Footer from '../components/Footer.astro';
import { defaultLocale } from '../lib/i18n';

/*
  Its own page for the same reason the menu has one: 23 full-width photographs
  are a large share of the homepage's weight, and a link wants a URL that IS the
  gallery. No extra structured data — the Restaurant graph stays on the homepage.
*/
const locale = defaultLocale;
---

<Base locale={locale} titleKey="meta.galleryTitle" descriptionKey="meta.galleryDescription">
  <Nav locale={locale} />

  {/* id="main" is the skip link's target. The footer's "back to top" uses
      href="#top", which needs no element. */}
  <main id="main">
    <Gallery locale={locale} />
  </main>

  <Footer locale={locale} />
</Base>
