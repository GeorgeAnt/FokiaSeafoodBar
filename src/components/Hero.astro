---
import { Picture } from 'astro:assets';
import { t, defaultLocale, type Locale } from '../lib/i18n';
import { carouselPhotos, logoWordmark } from '../lib/photos';
import site from '../data/site.json';

interface Props {
  locale?: Locale;
}
const { locale = defaultLocale } = Astro.props;
---

<section class="hero" id="top">
  <div class="hero__grid">
    <div class="hero__copy">
      {/*
        The wordmark is the client's logo artwork drawn as a CSS mask, not an
        <img>, so its colour stays a token: the artwork is pure white on
        transparency, and masked, the element's own background is the colour.
        See .hero__wordmark in global.css.

        That costs the alt attribute, so the accessible name is .sr-only text —
        "fokia seafood bar", the homepage's only h1 — with the mark aria-hidden
        so it is not announced twice. hero.tagline is the same words in both
        locales but still carries data-i18n, so the switch owns it.
      */}
      <h1 class="hero__wordmark">
        <span
          class="hero__wordmark-mark"
          style={`--wordmark: url(${logoWordmark.src})`}
          aria-hidden="true"
        />
        <span class="sr-only">
          {site.name} <span data-i18n="hero.tagline">{t(locale, 'hero.tagline')}</span>
        </span>
      </h1>

      <p class="hero__intro" data-i18n="hero.intro">{t(locale, 'hero.intro')}</p>

      {/*
        One call to action: reservations are a phone call, and the number is
        rendered in Take away, so a hero button could only scroll to it.
      */}
      <div class="hero__actions">
        <a class="btn btn--primary" href="/menu" data-i18n="hero.cta">{t(locale, 'hero.cta')}</a>
      </div>
    </div>

    <div class="hero__media" id="hero-media">
      {
        carouselPhotos.map((photo, index) => (
          <div class="hero__slide" data-active={index === 0 ? 'true' : 'false'}>
            {/*
              Widths are closely spaced on purpose: with only 600/900/1200
              available, a 412px viewport at DPR 1.75 needs 721px and is served
              900 — roughly 46% more bytes than it can use.
            */}
            <Picture
              src={photo}
              formats={['avif', 'webp']}
              widths={[400, 600, 800, 1000, 1300, 1600]}
              sizes="(min-width: 60rem) 50vw, 100vw"
              alt=""
              loading={index === 0 ? 'eager' : 'lazy'}
              decoding="async"
              fetchpriority={index === 0 ? 'high' : 'auto'}
            />
          </div>
        ))
      }
      {/*
        The controls live in a <template> so a visitor without JS is never shown
        a control that does nothing — but the labels are rendered by Astro in the
        right locale and carry data-i18n-label. Cloned nodes are invisible to the
        switcher's initial pass, so the script calls fokiaI18n.refresh() once
        they are in the page.

        One child: the dot strip. The stop button was removed at the client's
        request — see the WCAG note on start() for what that costs. Bare dashes,
        no arrows and no scrim pill; see global.css for what that costs.
      */}
      <template id="hero-controls-template">
        <div class="hero__dots"></div>
      </template>

      {/*
        `a11y.heroGoTo` carries an {n} placeholder. The number is per-dot, so the
        base string travels on the template and the index is substituted below;
        data-i18n-n lets the language switch redo the same substitution.
      */}
      <template id="hero-dot-template">
        <button type="button" data-i18n-label="a11y.heroGoTo" data-label-template={t(locale, 'a11y.heroGoTo')}></button>
      </template>
    </div>
  </div>
</section>

<script>
  /**
   * Hero crossfade. Everything below is enhancement: with no JS the first slide
   * stays visible, which is also the fastest possible LCP. None of it runs when
   * the visitor has asked for reduced motion.
   */
  const media = document.getElementById('hero-media');
  const slides = media ? Array.from(media.querySelectorAll<HTMLElement>('.hero__slide')) : [];
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const controlsTemplate = document.querySelector<HTMLTemplateElement>('#hero-controls-template');
  const dotTemplate = document.querySelector<HTMLTemplateElement>('#hero-dot-template');

  if (media && controlsTemplate && dotTemplate && slides.length > 1 && !reduceMotion.matches) {
    const INTERVAL = 3000;
    let current = 0;
    let timer: number | undefined;
    /* The transient hold while a pointer or the keyboard is in the hero. */
    let hovering = false;

    // Reveals slides 2..n, which until now were display:none so they would not
    // download during the initial load. Deferred to the load event so they never
    // compete with the LCP image.
    const reveal = () => media.setAttribute('data-enhanced', 'true');
    if (document.readyState === 'complete') reveal();
    else window.addEventListener('load', reveal, { once: true });

    // Controls come from templates so they exist only once JS is running, but
    // still arrive with Astro-rendered labels in the current locale.
    const controls = controlsTemplate.content.cloneNode(true) as DocumentFragment;
    const dotList = controls.querySelector<HTMLElement>('.hero__dots')!;

    const dots = slides.map((_, i) => {
      const dot = dotTemplate.content.firstElementChild!.cloneNode(true) as HTMLButtonElement;
      const label = dot.getAttribute('data-label-template') || '{n}';
      dot.removeAttribute('data-label-template');
      dot.setAttribute('data-i18n-n', String(i + 1));
      dot.setAttribute('aria-label', label.replace('{n}', String(i + 1)));
      dot.setAttribute('aria-current', String(i === 0));
      dot.addEventListener('click', () => {
        show(i);
        start();
      });
      dotList.append(dot);
      return dot;
    });

    const show = (next_: number) => {
      current = (next_ + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        slide.dataset.active = String(i === current);
      });
      dots.forEach((dot, i) => {
        dot.setAttribute('aria-current', String(i === current));
      });
    };

    /*
      KNOWN WCAG 2.2.2 FAILURE, accepted by the client. Read before "fixing"
      either half of it.

      2.2.2 requires that anything moving automatically for more than five
      seconds can be paused, stopped or hidden. This advances every 3s and never
      stops; the control that satisfied it (.hero__pause) was removed on request.

      The hold below is NOT a substitute: a touch visitor has no hover, and it
      ends the moment the pointer leaves. Nor are the dots — they jump between
      slides, they do not stop the timer. prefers-reduced-motion skips this
      block, which covers the vestibular case, not control.

      Restoring compliance means putting a stop control back. Shortening the
      interval does not help: 2.2.2 counts total duration, not the gap.
    */
    const start = () => {
      window.clearInterval(timer);
      if (hovering) return;
      timer = window.setInterval(() => show(current + 1), INTERVAL);
    };

    media.append(controls);
    // Cloned nodes never went through the switcher's initial pass — see the
    // note on the template. Without this the dots keep their server-rendered
    // Greek labels for a visitor who has chosen English.
    window.fokiaI18n?.refresh();
    start();

    // Hovering or tabbing into the hero holds the current photo, so nobody
    // loses the frame they were looking at. A convenience, not a mechanism.
    const setHovering = (value: boolean) => {
      hovering = value;
      start();
    };
    media.addEventListener('pointerenter', () => setHovering(true));
    media.addEventListener('pointerleave', () => setHovering(false));
    media.addEventListener('focusin', () => setHovering(true));
    media.addEventListener('focusout', () => setHovering(false));

    // Pause while the tab is hidden, so a backgrounded page is not decoding
    // images nobody is looking at.
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) window.clearInterval(timer);
      else start();
    });
  }
</script>
