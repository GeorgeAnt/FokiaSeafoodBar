---
import { Image, Picture } from 'astro:assets';
import { t, defaultLocale, type Locale } from '../lib/i18n';
import { carouselPhotos, logoClean } from '../lib/photos';
import site from '../data/site.json';

interface Props {
  locale?: Locale;
}
const { locale = defaultLocale } = Astro.props;
---

<section class="hero" id="top">
  <div class="hero__grid">
    <div class="hero__copy">
      {/*
        The logo itself, replacing the typeset "fokia / SEAFOOD BAR" lockup.

        logo-clean.png has a transparent surround so it can sit on the black,
        but the concrete texture is still inside the badge — it reads as a pale
        disc rather than a wordmark floating on the ground. That is the supplied
        artwork. A tightly cropped or vector version would sit better here.

        It stays wrapped in the h1 because this is the homepage's only one, and
        the alt text is what gives that heading its accessible name. The alt is
        composed rather than a single key and needs no data-i18n-alt: the brand
        name is not translated and `hero.tagline` is "seafood bar" in both
        locales, so the string is identical either way.
      */}
      <h1 class="hero__logo">
        <Image
          src={logoClean}
          alt={`${site.name} — ${t(locale, 'hero.tagline')}`}
          widths={[400, 800]}
          sizes="(min-width: 60rem) 24rem, 16rem"
          loading="eager"
        />
      </h1>

      <p class="hero__intro" data-i18n="hero.intro">{t(locale, 'hero.intro')}</p>

      {/*
        One call to action. Reservations are a phone call, and the number is
        rendered once in Take away & Reservations — a hero button could only
        scroll to it, so the menu is the thing worth sending people to.
      */}
      <div class="hero__actions">
        <a class="btn btn--primary" href="/menu" data-i18n="hero.cta">{t(locale, 'hero.cta')}</a>
      </div>
    </div>

    <div class="hero__media" id="hero-media">
      {
        carouselPhotos.map((photo, index) => (
          <div class="hero__slide" data-active={index === 0 ? 'true' : 'false'}>
            {/*
              Widths are closely spaced on purpose: with only 600/900/1200
              available, a 412px viewport at DPR 1.75 needs 721px and is served
              900 — roughly 46% more bytes than it can use.
            */}
            <Picture
              src={photo}
              formats={['avif', 'webp']}
              widths={[400, 600, 800, 1000, 1300, 1600]}
              sizes="(min-width: 60rem) 50vw, 100vw"
              alt=""
              loading={index === 0 ? 'eager' : 'lazy'}
              decoding="async"
              fetchpriority={index === 0 ? 'high' : 'auto'}
            />
          </div>
        ))
      }
      {/*
        The controls live in a <template> rather than in the DOM so a visitor
        without JavaScript is never shown a control that cannot do anything —
        but the labels are still rendered by Astro, in the right locale, and
        carry data-i18n-label so the language switch keeps translating them
        after the script has cloned them. Cloned nodes are invisible to the
        switcher's initial pass, so the script calls `fokiaI18n.refresh()` once
        they are in the page.

        Two children, positioned independently rather than as one row: the dot
        strip stays centred exactly where it was, and the stop button sits in
        the corner out of its way.

        Dashes only for the dots, as originally designed: no arrows and no scrim
        pill behind them. See the note in global.css about what that costs — and
        about why the stop button, unlike them, does carry a scrim.
      */}
      <template id="hero-controls-template">
        <div class="hero__dots"></div>
        <button
          type="button"
          class="hero__pause"
          data-hero-pause
          data-paused="false"
          aria-label={t(locale, 'a11y.heroPause')}
          data-i18n-label="a11y.heroPause"
        >
          {/* Both glyphs ship; CSS shows whichever matches [data-paused]. */}
          <svg data-icon="pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <rect x="7" y="5" width="3.4" height="14" rx="1" />
            <rect x="13.6" y="5" width="3.4" height="14" rx="1" />
          </svg>
          <svg data-icon="play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M8 5.2v13.6a1 1 0 0 0 1.53.85l10.2-6.8a1 1 0 0 0 0-1.7L9.53 4.35A1 1 0 0 0 8 5.2Z" />
          </svg>
        </button>
      </template>

      {/*
        `a11y.heroGoTo` carries an {n} placeholder. The number is per-dot, so the
        base string travels on the template and the index is substituted below;
        data-i18n-n lets the language switch redo the same substitution.
      */}
      <template id="hero-dot-template">
        <button type="button" data-i18n-label="a11y.heroGoTo" data-label-template={t(locale, 'a11y.heroGoTo')}></button>
      </template>
    </div>
  </div>
</section>

<script>
  /**
   * Hero crossfade.
   *
   * Everything below is enhancement: with no JS the first slide stays visible
   * and the hero is a still image, which is also the fastest possible LCP.
   * Nothing here runs when the visitor has asked for reduced motion.
   */
  const media = document.getElementById('hero-media');
  const slides = media ? Array.from(media.querySelectorAll<HTMLElement>('.hero__slide')) : [];
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const controlsTemplate = document.querySelector<HTMLTemplateElement>('#hero-controls-template');
  const dotTemplate = document.querySelector<HTMLTemplateElement>('#hero-dot-template');

  if (media && controlsTemplate && dotTemplate && slides.length > 1 && !reduceMotion.matches) {
    const INTERVAL = 6000;
    let current = 0;
    let timer: number | undefined;
    /* Two different kinds of not-advancing, and they must not overwrite each
       other. `hovering` is the transient hold while a pointer or the keyboard
       is in the hero; `stopped` is the visitor having pressed stop, which
       outlives the pointer leaving and is the WCAG 2.2.2 mechanism. */
    let hovering = false;
    let stopped = false;

    // Reveals slides 2..n, which until now were display:none so they would not
    // download during the initial load. Deferred to the load event so they never
    // compete with the LCP image.
    const reveal = () => media.setAttribute('data-enhanced', 'true');
    if (document.readyState === 'complete') reveal();
    else window.addEventListener('load', reveal, { once: true });

    // Controls come from templates so they exist only once JS is running, but
    // still arrive with Astro-rendered labels in the current locale. The clone
    // is the whole fragment: the dot strip and the stop button, which are
    // positioned separately rather than sharing a row.
    const controls = controlsTemplate.content.cloneNode(true) as DocumentFragment;
    const dotList = controls.querySelector<HTMLElement>('.hero__dots')!;
    const pauseButton = controls.querySelector<HTMLButtonElement>('[data-hero-pause]')!;

    const dots = slides.map((_, i) => {
      const dot = dotTemplate.content.firstElementChild!.cloneNode(true) as HTMLButtonElement;
      const label = dot.getAttribute('data-label-template') || '{n}';
      dot.removeAttribute('data-label-template');
      dot.setAttribute('data-i18n-n', String(i + 1));
      dot.setAttribute('aria-label', label.replace('{n}', String(i + 1)));
      dot.setAttribute('aria-current', String(i === 0));
      dot.addEventListener('click', () => {
        show(i);
        start();
      });
      dotList.append(dot);
      return dot;
    });

    const show = (next_: number) => {
      current = (next_ + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        slide.dataset.active = String(i === current);
      });
      dots.forEach((dot, i) => {
        dot.setAttribute('aria-current', String(i === current));
      });
    };

    const start = () => {
      window.clearInterval(timer);
      if (hovering || stopped) return;
      timer = window.setInterval(() => show(current + 1), INTERVAL);
    };

    /*
      WCAG 2.2.2: content that moves for more than five seconds needs a
      mechanism to stop it, and it has to be one every visitor can operate.
      Holding on hover and focus is not that — a touch visitor has no hover, and
      the hold ends the moment the pointer leaves. This button is the mechanism;
      the hold below is a convenience on top of it.
    */
    pauseButton.addEventListener('click', () => {
      stopped = !stopped;
      pauseButton.dataset.paused = String(stopped);
      window.fokiaI18n?.setLabelKey(pauseButton, stopped ? 'a11y.heroPlay' : 'a11y.heroPause');
      start();
    });

    media.append(controls);
    // Cloned nodes never went through the switcher's initial pass — see the
    // note on the template. Without this the dots and this button keep their
    // server-rendered Greek labels for a visitor who has chosen English.
    window.fokiaI18n?.refresh();
    start();

    // Hovering or tabbing into the hero holds the current photo, so nobody
    // loses the frame they were looking at — or the button they were reaching
    // for. It never overrides an explicit stop.
    const setHovering = (value: boolean) => {
      hovering = value;
      start();
    };
    media.addEventListener('pointerenter', () => setHovering(true));
    media.addEventListener('pointerleave', () => setHovering(false));
    media.addEventListener('focusin', () => setHovering(true));
    media.addEventListener('focusout', () => setHovering(false));

    // Pause while the tab is hidden, so a backgrounded page is not decoding
    // images nobody is looking at.
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) window.clearInterval(timer);
      else start();
    });
  }
</script>
