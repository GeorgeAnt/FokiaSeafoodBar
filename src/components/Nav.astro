---
import { Image } from 'astro:assets';
import SocialLinks from './SocialLinks.astro';
import { logoClean } from '../lib/photos';
import { t, defaultLocale, type Locale } from '../lib/i18n';

interface Props {
  locale?: Locale;
}
const { locale = defaultLocale } = Astro.props;

/*
  Logo, then one list in reading order, with the utilities after it.

  The logo is at the start of the row, not centred. The bar used to centre one
  absolutely, which is what forced the links into two balanced groups; in flow
  at the left it costs the row its own width and nothing else, so the links stay
  a single run and the social icons and the language switch sit at the end
  because that is where you go looking for them.

  It renders logo-clean.png, the same file the hero and the footer use, cropped
  by `object-fit` rather than by a second asset — see the note on `.nav__logo`
  in global.css for why that is safe and what it saves.

  Section links are rooted ("/#team", not "#team") because the nav also renders
  on /menu and /gallery, where those sections do not exist. From the homepage a
  rooted fragment is still a same-document jump, so nothing reloads.
*/
const links = [
  { href: '/#goal', key: 'nav.goal' },
  { href: '/#team', key: 'nav.team' },
  { href: '/menu', key: 'nav.menu' },
  { href: '/gallery', key: 'nav.gallery' },
  { href: '/#contact', key: 'nav.contact' },
  { href: '/#find-us', key: 'nav.findUs' },
];

/** Marks the current page in the nav for assistive tech. */
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => href.replace(/\/$/, '') === path;
---

<header class="nav">
  <nav
    class="wrap nav__inner"
    id="nav-inner"
    aria-label={t(locale, 'a11y.mainNav')}
    data-i18n-label="a11y.mainNav"
  >
    <a class="nav__logo" href="/" aria-label={t(locale, 'a11y.home')} data-i18n-label="a11y.home">
      {/*
        alt="" on purpose. The link carries the accessible name, so a non-empty
        alt here would announce the mark twice — and on the homepage the <h1> is
        this same logo, whose alt is what gives the page its heading. Two
        identical accessible names in one document is what that would produce.
      */}
      <Image src={logoClean} alt="" widths={[112, 224]} sizes="56px" loading="eager" />
    </a>

    <ul class="nav__links" id="nav-links">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              data-i18n={link.key}
              aria-current={isCurrent(link.href) ? 'page' : undefined}
            >
              {t(locale, link.key)}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="nav__utils">
      <SocialLinks class="nav__social" />

      <div
        class="lang"
        role="group"
        aria-label={t(locale, 'a11y.languageSwitcher')}
        data-i18n-label="a11y.languageSwitcher"
      >
        <button type="button" data-lang-btn="el" aria-pressed="true">ΕΛ</button>
        <button type="button" data-lang-btn="en" aria-pressed="false">EN</button>
      </div>
    </div>

    <button
      type="button"
      class="nav__toggle"
      id="nav-toggle"
      aria-expanded="false"
      aria-controls="nav-links"
      aria-label={t(locale, 'a11y.openMenu')}
      data-i18n-label="a11y.openMenu"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M3 6h18M3 12h18M3 18h18" stroke-linecap="round" />
      </svg>
    </button>
  </nav>
</header>

<script>
  // Mobile navigation. The open state lives on the bar rather than on the list,
  // because the stacked panel is laid out by the bar's own wrap.
  const toggle = document.getElementById('nav-toggle');
  const inner = document.getElementById('nav-inner');

  if (toggle && inner) {
    const setOpen = (open: boolean) => {
      inner.dataset.open = String(open);
      toggle.setAttribute('aria-expanded', String(open));
      // The label has to follow the state, not just aria-expanded: the key is
      // swapped rather than the string, so the language switch can still reach
      // it afterwards. `a11y.closeMenu` had been in both dictionaries unused.
      window.fokiaI18n?.setLabelKey(toggle, open ? 'a11y.closeMenu' : 'a11y.openMenu');
    };

    toggle.addEventListener('click', () => {
      setOpen(inner.dataset.open !== 'true');
    });

    // Tapping a link should close the panel, not leave it covering the target.
    inner.addEventListener('click', (event) => {
      const el = event.target as HTMLElement;
      if (el.closest('.nav__links a')) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && inner.dataset.open === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>
