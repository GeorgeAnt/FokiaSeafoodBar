---
import { Image } from 'astro:assets';
import SocialLinks from './SocialLinks.astro';
import { logoClean } from '../lib/photos';
import { t, defaultLocale, type Locale } from '../lib/i18n';

interface Props {
  locale?: Locale;
}
const { locale = defaultLocale } = Astro.props;

/*
  Logo, then one list in reading order, then the utilities. The link list is
  never shown inline — .nav__inner always renders it as a dropdown panel behind
  the burger toggle, at every viewport width — so source order governs reading
  and tab order only, and a seventh link costs the bar nothing.

  Section links are rooted ("/#goal", not "#goal") because the nav also renders
  on /menu, /gallery and /team. From the homepage a rooted fragment is still a
  same-document jump.
*/
const links = [
  { href: '/#goal', key: 'nav.goal' },
  { href: '/team', key: 'nav.team' },
  { href: '/menu', key: 'nav.menu' },
  { href: '/gallery', key: 'nav.gallery' },
  { href: '/#contact', key: 'nav.contact' },
  { href: '/#find-us', key: 'nav.findUs' },
];

/** The language button names the locale it switches TO, so everything about it
 *  is derived from the other locale rather than the current one. */
const other = locale === 'el' ? 'en' : 'el';

/** Marks the current page in the nav for assistive tech. */
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => href.replace(/\/$/, '') === path;
---

<header class="nav">
  <nav
    class="wrap nav__inner"
    id="nav-inner"
    aria-label={t(locale, 'a11y.mainNav')}
    data-i18n-label="a11y.mainNav"
  >
    <a class="nav__logo" href="/" aria-label={t(locale, 'a11y.home')} data-i18n-label="a11y.home">
      {/*
        alt="" on purpose: the link already carries the accessible name, and on
        the homepage the h1 is this same mark.
      */}
      {/*
        sizes is 142px, not the 80px the box measures: srcset picks from the
        img's LAYOUT width, but object-fit: cover crops 47% of this file away
        (1672x940, badge centred), so 80 x 1672/940 = 142 is the width that
        fills the box, and 284 is its 2x. Resize .nav__logo and both move.
      */}
      <Image src={logoClean} alt="" widths={[142, 284]} sizes="142px" loading="eager" />
    </a>

    <ul class="nav__links" id="nav-links">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              data-i18n={link.key}
              aria-current={isCurrent(link.href) ? 'page' : undefined}
            >
              {t(locale, link.key)}
            </a>
          </li>
        ))
      }
    </ul>

    <SocialLinks class="nav__social" />

    <div class="nav__utils">
      {/*
        One button, labelled with the language it switches TO, so the label is
        the action rather than a state. No aria-pressed and no role="group": it
        performs an action, it does not report a setting.

        Four attributes travel together and apply() in Base re-aims all four at
        the other locale on every switch: data-lang-target (the button's whole
        state), lang (the text is a language's own name — without it a screen
        reader says "English" with Greek phonemes), and data-i18n /
        data-i18n-label, which stay dictionary lookups.

        lang.el / lang.en are autonyms and are deliberately identical in both
        locale files; a11y.lang.* are sentences and do translate. All are built
        at runtime from a locale code, so none of them greps — deleting one
        breaks this button silently, and npm run check only compares keys
        across locales, never whether a key is used.
      */}
      <button
        type="button"
        class="lang"
        data-lang-target={other}
        lang={other}
        aria-label={t(locale, `a11y.lang.${other}`)}
        data-i18n-label={`a11y.lang.${other}`}
      >
        {/*
          Only .lang__name ever shows — .lang__code is hidden unconditionally
          now the button is small enough not to need a narrower fallback. Both
          still carry data-i18n and are re-aimed by apply(), so the swap could
          be reinstated. Safe for assistive tech: the name comes from aria-label.
        */}
        <span class="lang__name" data-lang-name data-i18n={`lang.${other}`}>
          {t(locale, `lang.${other}`)}
        </span>
        <span class="lang__code" data-lang-code data-i18n={`lang.short.${other}`}>
          {t(locale, `lang.short.${other}`)}
        </span>
      </button>

      {/*
        The toggle sits inside .nav__utils rather than beside it because the bar
        is a three-track grid and the social icons own the middle track:
        everything right of them has to be one grid item, or the icons stop
        centring against the bar.
      */}
      <button
        type="button"
        class="nav__toggle"
        id="nav-toggle"
        aria-expanded="false"
        aria-controls="nav-links"
        aria-label={t(locale, 'a11y.openMenu')}
        data-i18n-label="a11y.openMenu"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </nav>
</header>

<script>
  // Mobile navigation. The open state lives on the bar rather than on the list,
  // because the stacked panel is laid out by the bar's own wrap.
  const toggle = document.getElementById('nav-toggle');
  const inner = document.getElementById('nav-inner');

  if (toggle && inner) {
    const setOpen = (open: boolean) => {
      inner.dataset.open = String(open);
      toggle.setAttribute('aria-expanded', String(open));
      // The label follows the state, not just aria-expanded — and the KEY is
      // swapped rather than the string, so the language switch can still reach
      // it afterwards.
      window.fokiaI18n?.setLabelKey(toggle, open ? 'a11y.closeMenu' : 'a11y.openMenu');
    };

    toggle.addEventListener('click', () => {
      setOpen(inner.dataset.open !== 'true');
    });

    // Tapping a link should close the panel, not leave it covering the target.
    inner.addEventListener('click', (event) => {
      const el = event.target as HTMLElement;
      if (el.closest('.nav__links a')) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && inner.dataset.open === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });

    // A click outside the bar closes the panel. The toggle is inside inner, so
    // contains() already excludes the click that opened it.
    document.addEventListener('click', (event) => {
      if (inner.dataset.open !== 'true') return;
      if (!inner.contains(event.target as Node)) setOpen(false);
    });
  }
</script>
