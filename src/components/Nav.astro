---
import { Image } from 'astro:assets';
import SocialLinks from './SocialLinks.astro';
import { logoClean } from '../lib/photos';
import { t, defaultLocale, type Locale } from '../lib/i18n';

interface Props {
  locale?: Locale;
}
const { locale = defaultLocale } = Astro.props;

/*
  Logo, then one list in reading order, with the utilities after it.

  Source order is left-to-right and matches the tab order; the *visual* centring
  of the links is done by the grid in .nav__inner and moves nothing here. The
  logo is at the start, not centred — the bar used to centre one absolutely,
  which is what forced the links into two balanced groups, and it stays in flow
  so the links can remain a single run. The social icons and the language button
  sit at the end because that is where you go looking for them.

  It renders logo-clean.png, the same file the hero and the footer use, cropped
  by `object-fit` rather than by a second asset — see the note on `.nav__logo`
  in global.css for why that is safe and what it saves.

  Section links are rooted ("/#team", not "#team") because the nav also renders
  on /menu and /gallery, where those sections do not exist. From the homepage a
  rooted fragment is still a same-document jump, so nothing reloads.
*/
const links = [
  { href: '/#goal', key: 'nav.goal' },
  { href: '/#team', key: 'nav.team' },
  { href: '/menu', key: 'nav.menu' },
  { href: '/gallery', key: 'nav.gallery' },
  { href: '/#contact', key: 'nav.contact' },
  { href: '/#find-us', key: 'nav.findUs' },
];

/**
 * The language button names the locale it switches *to*, so everything about it
 * is derived from the other one rather than from the current one.
 */
const other = locale === 'el' ? 'en' : 'el';

/** Marks the current page in the nav for assistive tech. */
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => href.replace(/\/$/, '') === path;
---

<header class="nav">
  <nav
    class="wrap nav__inner"
    id="nav-inner"
    aria-label={t(locale, 'a11y.mainNav')}
    data-i18n-label="a11y.mainNav"
  >
    <a class="nav__logo" href="/" aria-label={t(locale, 'a11y.home')} data-i18n-label="a11y.home">
      {/*
        alt="" on purpose. The link carries the accessible name, so a non-empty
        alt here would announce the mark twice — and on the homepage the <h1> is
        this same logo, whose alt is what gives the page its heading. Two
        identical accessible names in one document is what that would produce.
      */}
      {/*
        sizes is 142px, not the 80px the box actually measures. srcset picks a
        candidate from the img's *layout* width, but object-fit: cover crops 47%
        of this file away (1672x940, badge centred — see .nav__logo in
        global.css), so a file laid out at 80px renders a 45px mark in an 80px
        box. 80 x 1672/940 = 142 is the width that fills it, and 284 is its 2x.
        Resize .nav__logo and both numbers move with it.
      */}
      <Image src={logoClean} alt="" widths={[142, 284]} sizes="142px" loading="eager" />
    </a>

    <ul class="nav__links" id="nav-links">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              data-i18n={link.key}
              aria-current={isCurrent(link.href) ? 'page' : undefined}
            >
              {t(locale, link.key)}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="nav__utils">
      <SocialLinks class="nav__social" />

      {/*
        One button, not a pair of them. It is labelled with the language it will
        switch *to* — "English" on the Greek page, "ΕΛ" on the English one — so
        the label is the action rather than a state the visitor has to read off
        a highlighted segment. There is no `aria-pressed` and no `role="group"`
        any more: this performs an action, it does not report a setting, and
        `a11y.languageSwitcher` went with them.

        Four attributes travel together, and `apply()` in Base rewrites all four
        to point at the other locale every time the language changes:

          data-lang-target — what a click switches to, and what the click
            handler reads. It is the button's whole state.
          lang — the text is a language's own name, so it has to be marked as
            that language. Without it a screen reader on the Greek page reads
            "English" with Greek phonemes.
          data-i18n / data-i18n-label — visible text and spoken label. Both stay
            dictionary lookups: the script picks the key, never the string,
            which is the same contract `setLabelKey` follows.

        `lang.el` / `lang.en` are autonyms and are deliberately identical in both
        locale files — a language names itself the same way whoever is reading,
        like `footer.rights`. `a11y.lang.*` are sentences and do translate. Both
        families are built at runtime from a locale code, so neither appears
        literally anywhere and neither will grep. Deleting one breaks this button
        silently; `npm run check` compares keys across locales and never asks
        whether a key is used.
      */}
      <button
        type="button"
        class="lang"
        data-lang-target={other}
        lang={other}
        aria-label={t(locale, `a11y.lang.${other}`)}
        data-i18n-label={`a11y.lang.${other}`}
      >
        {/*
          Two labels, one shown at a time by CSS. The word is what the client
          asked for and is what shows everywhere it fits; the two-letter code
          takes over on the collapsed bar at 22.5rem, where "English" costs 88px
          against a 280px row and pushed the toggle onto a second line. The
          swap is CSS-only — no second script path, and no measuring in JS.

          Hiding one is safe for assistive tech because the button's accessible
          name comes from aria-label, not from this text.
        */}
        <span class="lang__name" data-lang-name data-i18n={`lang.${other}`}>
          {t(locale, `lang.${other}`)}
        </span>
        <span class="lang__code" data-lang-code data-i18n={`lang.short.${other}`}>
          {t(locale, `lang.short.${other}`)}
        </span>
      </button>
    </div>

    <button
      type="button"
      class="nav__toggle"
      id="nav-toggle"
      aria-expanded="false"
      aria-controls="nav-links"
      aria-label={t(locale, 'a11y.openMenu')}
      data-i18n-label="a11y.openMenu"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M3 6h18M3 12h18M3 18h18" stroke-linecap="round" />
      </svg>
    </button>
  </nav>
</header>

<script>
  // Mobile navigation. The open state lives on the bar rather than on the list,
  // because the stacked panel is laid out by the bar's own wrap.
  const toggle = document.getElementById('nav-toggle');
  const inner = document.getElementById('nav-inner');

  if (toggle && inner) {
    const setOpen = (open: boolean) => {
      inner.dataset.open = String(open);
      toggle.setAttribute('aria-expanded', String(open));
      // The label has to follow the state, not just aria-expanded: the key is
      // swapped rather than the string, so the language switch can still reach
      // it afterwards. `a11y.closeMenu` had been in both dictionaries unused.
      window.fokiaI18n?.setLabelKey(toggle, open ? 'a11y.closeMenu' : 'a11y.openMenu');
    };

    toggle.addEventListener('click', () => {
      setOpen(inner.dataset.open !== 'true');
    });

    // Tapping a link should close the panel, not leave it covering the target.
    inner.addEventListener('click', (event) => {
      const el = event.target as HTMLElement;
      if (el.closest('.nav__links a')) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && inner.dataset.open === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>
