---
import { getImage } from 'astro:assets';
import MenuCategory from './MenuCategory.astro';
import { foodCategories, drinkCategories } from '../lib/menu';
import { t, defaultLocale, type Locale } from '../lib/i18n';
import legal from '../data/legal.json';
import greyConcrete from '../assets/photos/backgrounds/grunge-gray-cement-textured-background.jpg';

interface Props {
  locale?: Locale;
}
const { locale = defaultLocale } = Astro.props;

// TEMP: same concrete ground as /team and /gallery — see
// .section--concrete-test in global.css, which owns the overlay, the token
// changes and why 2560 is enough. This only hands it the optimised texture;
// the source jpg is 9.3MB.
const bgTest = await getImage({ src: greyConcrete, format: 'webp', width: 2560 });

const views = [
  { id: 'food', key: 'menu.food', categories: foodCategories },
  { id: 'drinks', key: 'menu.drinks', categories: drinkCategories },
];
---

<section
  class="section section--concrete-test"
  id="menu"
  style={`--bg-texture: url(${bgTest.src})`}
>
  <div class="wrap">
    <header class="section-head" lang={locale}>
      {/* The menu has a page to itself, so this is the page's h1. */}
      <h1 data-i18n="menu.heading">{t(locale, 'menu.heading')}</h1>
    </header>

    <!--
      Food / Drinks switch. Two radio inputs plus CSS sibling selectors: no
      JavaScript, keyboard-operable with the arrow keys, and the whole menu is
      in the HTML either way, so search engines index all 98 items.
    -->
    <div class="menu__switch">
      <input
        class="menu__switch-input"
        type="radio"
        name="menu-view"
        id="menu-view-food"
        checked
      />
      <input class="menu__switch-input" type="radio" name="menu-view" id="menu-view-drinks" />

      <div class="menu__tablist" lang={locale}>
        {
          views.map((view) => (
            <label class="menu__tab" for={`menu-view-${view.id}`} data-i18n={view.key}>
              {t(locale, view.key)}
            </label>
          ))
        }
      </div>

      {
        views.map((view) => (
          <div class={`menu__panel menu__panel--${view.id}`}>
            <nav class="menu__jump" aria-label={t(locale, 'menu.jumpTo')} data-i18n-label="menu.jumpTo">
              {view.categories.map((category) => (
                <a href={`#cat-${category.id}`} data-i18n={`menu.category.${category.id}.name`}>
                  {t(locale, `menu.category.${category.id}.name`)}
                </a>
              ))}
            </nav>

            <div class="menu__categories">
              {view.categories.map((category) => (
                <MenuCategory category={category} locale={locale} />
              ))}
            </div>
          </div>
        ))
      }
    </div>

    <!--
      Required on the menu by Greek regulation. Always rendered, never behind a
      toggle, never shortened, and bilingual — the client supplied both.
    -->
    <aside class="menu__legal" lang={locale}>
      <h2 data-i18n="menu.legalHeading">{t(locale, 'menu.legalHeading')}</h2>
      <ul>
        {
          legal.notices.map((notice) => (
            <li data-i18n={`legal.${notice.id}`}>{t(locale, `legal.${notice.id}`)}</li>
          ))
        }
        <li>
          <span data-i18n="legal.manager.label">{t(locale, 'legal.manager.label')}</span>:{' '}
          <span data-i18n="legal.manager.name">{t(locale, 'legal.manager.name')}</span>,{' '}
          <a href={`tel:${legal.commercialManager.phoneHref}`}>{legal.commercialManager.phone}</a>
        </li>
      </ul>
    </aside>
  </div>
</section>
