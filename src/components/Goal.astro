---
import { Picture } from 'astro:assets';
import { t, defaultLocale, type Locale } from '../lib/i18n';
import { galleryPhoto } from '../lib/photos';
import gallery from '../data/gallery.json';

interface Props {
  locale?: Locale;
}
const { locale = defaultLocale } = Astro.props;

/* Picked by id, never by position — gallery.json is ordered for the gallery, so
   reordering it must not change this band silently. Throws at build time. */
const GOAL_PHOTO_ID = 'toast-outdoors';
const photo = gallery.images.find((candidate) => candidate.id === GOAL_PHOTO_ID);
if (!photo) {
  throw new Error(
    `Our Goal wants the gallery image "${GOAL_PHOTO_ID}", which has no entry in ` +
      `data/gallery.json. Add one (with alt text in both locales), or point ` +
      `GOAL_PHOTO_ID in Goal.astro at an id that exists.`
  );
}
const photoSrc = galleryPhoto(photo.file);
const photoAltKey = `gallery.${photo.id}.alt`;
---

{/*
  A split built to continue the hero's grid: the photo column is the same
  half-width, full-bleed track the carousel sits in directly above, at the same
  height, so the top of the page reads as one 2x2 with the pictures on a
  diagonal. Source order is text then photo — that is the reading order and the
  order it stacks in on a phone; order: -1 moves the photo left only once the
  two are side by side.
*/}
<section class="section-dark goal" id="goal">
  {/* One reveal for the whole band: staggering made the heading arrive on its
      own above nothing. */}
  <div class="goal__grid" data-reveal>
    <div class="goal__col">
      {/*
        Renders nav.goal rather than a heading key of its own: goal.heading was
        deleted in a dead-key sweep for never being rendered, and re-adding it
        would put the same two words in two keys that can drift.
      */}
      <h2 class="goal__heading" data-i18n="nav.goal">{t(locale, 'nav.goal')}</h2>

      {/*
        The measure stays on .goal__body rather than on each paragraph: centred
        lines are read by their middles, so the two must share one axis.
      */}
      <div class="goal__body">
        <p data-i18n="goal.body">{t(locale, 'goal.body')}</p>
        <p data-i18n="goal.body2">{t(locale, 'goal.body2')}</p>
        <a class="btn btn--primary goal__cta" href="/team" data-i18n="goal.cta">
          {t(locale, 'goal.cta')}
        </a>
      </div>
    </div>

    {/*
      Widths mirror the hero carousel's, because the column is the same size. It
      keeps its real alt — nothing here is a link, so the picture is content
      rather than part of a control's name.
    */}
    <div class="goal__media">
      <Picture
        src={photoSrc}
        formats={['avif', 'webp']}
        widths={[400, 600, 800, 1000, 1300, 1600]}
        sizes="(min-width: 60rem) 50vw, 100vw"
        alt={t(locale, photoAltKey)}
        data-i18n-alt={photoAltKey}
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>
</section>
