---
import { Picture } from 'astro:assets';
import { t, defaultLocale, type Locale } from '../lib/i18n';
import { galleryPhoto } from '../lib/photos';
import site from '../data/site.json';
import gallery from '../data/gallery.json';

interface Props {
  locale?: Locale;
}
const { locale = defaultLocale } = Astro.props;

/* Looked up by filename because that is how this one was chosen. The id is
   still what drives the alt text, so the caption follows the photo without
   anything here having to restate it. */
const FIND_US_PHOTO = 'dsc-8248.jpg';
const photo = gallery.images.find((image) => image.file === FIND_US_PHOTO);
if (!photo) {
  throw new Error(
    `Where to Find Us wants ${FIND_US_PHOTO}, which has no entry in data/gallery.json. ` +
      `Add one (with alt text in both locales) before pointing the section at it.`
  );
}

const dayOrder = [
  'Monday',
  'Tuesday',
  'Wednesday',
  'Thursday',
  'Friday',
  'Saturday',
  'Sunday',
] as const;

/**
 * Collapses each entry's days into *contiguous* runs, so the block reads
 * "Τρί – Παρ" on one row instead of four separate rows.
 *
 * The runs are computed rather than taken as each entry's first and last day: an
 * entry listing Tuesday and Thursday would otherwise render as "Τρί – Πέμ" and
 * claim the restaurant is open on a Wednesday it is closed. Non-contiguous days
 * simply become separate rows.
 */
function runsOf(days: readonly string[]) {
  const indices = days
    .map((day) => dayOrder.indexOf(day as (typeof dayOrder)[number]))
    .filter((i) => i >= 0)
    .sort((a, b) => a - b);

  const runs: { from: string; to: string }[] = [];
  let start = -1;
  let previous = -Infinity;
  for (const i of indices) {
    if (i !== previous + 1) {
      if (start >= 0) runs.push({ from: dayOrder[start], to: dayOrder[previous] });
      start = i;
    }
    previous = i;
  }
  if (start >= 0) runs.push({ from: dayOrder[start], to: dayOrder[previous] });
  return runs;
}

const dayIndex = (day: string) => dayOrder.indexOf(day as (typeof dayOrder)[number]);

/*
  Every run, open and closed, ordered by the day it starts on — so the list
  reads Monday first and runs through the week.

  It used to be "the client's open ranges in the order they listed them, then
  the closed days", which put Monday last because Monday is the closed one. The
  client asked for it to read as a week instead. Sorting by dayIndex rather than
  by open-vs-closed is what does it, and it keeps working if the closed day ever
  moves: nothing here assumes which day is shut.

  A day the restaurant is shut is still listed. It is not a working hour, but
  dropping it leaves a visitor guessing about Monday.
*/
const schedule = [
  ...site.hours.entries.flatMap((entry) =>
    runsOf(entry.days).map((run) => ({ run, opens: entry.opens, closes: entry.closes }))
  ),
  ...runsOf(site.hours.closed).map((run) => ({ run, opens: null, closes: null })),
].sort((a, b) => dayIndex(a.run.from) - dayIndex(b.run.from));
---

<!--
  Charcoal, like every band below the hero, and the last of them: the hairline
  closing this band off from the black footer comes from the
  `main > .section-dark:last-child` rule rather than from this section. See
  `.section-dark` in global.css for the tokens it re-tints.
-->
<section class="section section-dark" id="find-us">
  <div class="wrap">
    {/*
      The heading is centred over the whole band rather than sitting in a
      column. It used to be inside the grid's first column so the photograph
      beside it started on the same line as the words; that photograph is gone
      and the grid is two text columns now, so a heading left in the first one
      would be centred over half the band and read as a column label instead of
      as the band's title.

      It carries its own data-reveal, like .plates__head, so the sibling rule in
      global.css brings the head in a beat ahead of the columns.
    */}
    {/*
      Not .section-head: that sets --step-3, and this heading is --step-2 to
      match From the kitchen and Our Goal. Same reasoning as .plates__head —
      the two rules have equal specificity, so overriding would have meant
      depending on source order. .section-head--inline existed only for this
      one header and went with it.
    */}
    <header class="find__head" data-reveal>
      <h2 data-i18n="findUs.heading">{t(locale, 'findUs.heading')}</h2>
    </header>

    {/*
      One text column — address, hours, phone, email, in that order, the same
      order the column stacks in below the breakpoint — beside the photograph.
      It used to be two text columns side by side with no photo at all; the
      client didn't like the band without one, and asked for the desktop layout
      to read the way the mobile stack already does, with the picture filling
      the space that freed up on the right. See .find__col and .find__media.
    */}
    <div class="find__grid" data-reveal>
      <div class="find__col">
        <div class="find__block">
          <p class="find__label" data-i18n="findUs.addressLabel">
            {t(locale, 'findUs.addressLabel')}
          </p>
          {/*
            Street and city only. The postcode and the country are still in the
            Restaurant JSON-LD, which is what local search reads; on the page
            they were three lines telling a visitor what one line tells them.
          */}
          {/*
            The address IS the map link now — the separate "view on map" button
            below it is gone.

            `findUs.viewOnMap` did not go with the button: it is carried as
            visually hidden text inside the link. That is deliberate rather than
            tidy-minded. The link has no underline (the client asked for those
            to go), so nothing on screen says it leads anywhere, and its
            accessible name would otherwise be a bare street address with no
            hint that it opens Google Maps in a new tab. Appending rather than
            using aria-label keeps the visible words *inside* the accessible
            name, which is what WCAG 2.5.3 (Label in Name) requires — a speech
            user saying "Laskou 3" still matches the link.

            The mapUrl guard stays: with no link the address renders as plain
            text rather than as a control that goes nowhere. See the note in
            CLAUDE.md about why that URL is a Place ID and must not be edited.
          */}
          <address class="find__address">
            {site.mapUrl ? (
              <a class="find__map" href={site.mapUrl} target="_blank" rel="noopener">
                <svg class="find__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                  <path d="M12 21c4-4.2 6.5-7.4 6.5-10.5a6.5 6.5 0 1 0-13 0C5.5 13.6 8 16.8 12 21z" />
                  <circle cx="12" cy="10.5" r="2.4" />
                </svg>
                <span>
                  <span data-i18n="site.street">{t(locale, 'site.street')}</span>{' '}
                  <span data-i18n="site.city">{t(locale, 'site.city')}</span>
                </span>
                <span class="sr-only" data-i18n="findUs.viewOnMap">
                  {' '}
                  {t(locale, 'findUs.viewOnMap')}
                </span>
              </a>
            ) : (
              <Fragment>
                <span data-i18n="site.street">{t(locale, 'site.street')}</span>{' '}
                <span data-i18n="site.city">{t(locale, 'site.city')}</span>
              </Fragment>
            )}
          </address>
        </div>

        <div class="find__block">
          <p class="find__label" data-i18n="findUs.hoursLabel">{t(locale, 'findUs.hoursLabel')}</p>
          <ul class="find__hours">
            {
              schedule.map(({ run, opens, closes }) => (
                <li>
                  {/*
                    The key goes on the inner spans, never the wrapper: the
                    language switch assigns textContent, so a data-i18n parent
                    would wipe the day names nested inside it.
                  */}
                  <span>
                    <span data-i18n={`hours.${run.from}`}>
                      {t(locale, `hours.${run.from}`)}
                    </span>
                    {run.to !== run.from && (
                      <Fragment>
                        {' '}
                        <span data-i18n="hours.rangeSeparator">
                          {t(locale, 'hours.rangeSeparator')}
                        </span>{' '}
                        <span data-i18n={`hours.${run.to}`}>
                          {t(locale, `hours.${run.to}`)}
                        </span>
                      </Fragment>
                    )}
                  </span>
                  {opens ? (
                    <span>
                      {opens}
                      <span data-i18n="hours.rangeSeparator">{t(locale, 'hours.rangeSeparator')}</span>
                      {closes}
                    </span>
                  ) : (
                    <span data-i18n="findUs.closed">{t(locale, 'findUs.closed')}</span>
                  )}
                </li>
              ))
            }
          </ul>
        </div>

        <div class="find__block">
          <p class="find__label" data-i18n="contact.phoneLabel">
            {t(locale, 'contact.phoneLabel')}
          </p>
          {/*
            Icons are inline SVG in the same idiom as SocialLinks — 24x24,
            fill none, stroke currentColor at 1.6 — rather than Font Awesome.
            The site ships no icon library and self-hosts everything it renders;
            three glyphs are not worth a CDN request, a webfont, or FA's CC BY
            attribution requirement, and inline SVG inherits currentColor so the
            icons follow the link's hover and focus states for free.

            aria-hidden on every one of them: the link text beside the icon is
            already the accessible name, and an unlabelled decorative glyph
            inside a link would either add nothing or duplicate it.
          */}
          <p class="find__contact">
            <a href={`tel:${site.phone.href}`}>
              <svg class="find__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                <path d="M6.5 3h3l1.5 4-2 1.5a12 12 0 0 0 5.5 5.5L16 12l4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.5 5.2 2 2 0 0 1 6.5 3z" />
              </svg>
              <span>{site.phone.display}</span>
            </a>
          </p>
        </div>

        {/*
          Email is its own .find__block rather than a second label inside the
          phone block, so every group in the column spaces the same way —
          `.find__block + .find__block`, 2rem. It used to ride on
          `.find__label--tight` (1.1rem) back when phone and email were a
          second column of their own; that rule existed only to level "Email"
          with "Ώρες λειτουργίας" next door, which stopped being a question the
          moment there was only one column to level.
        */}
        <div class="find__block">
          <p class="find__label" data-i18n="contact.emailLabel">
            {t(locale, 'contact.emailLabel')}
          </p>
          <p class="find__contact">
            <a href={`mailto:${site.email}`}>
              <svg class="find__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                <rect x="3" y="5" width="18" height="14" rx="2" />
                <path d="m3.6 6.6 8.4 5.9 8.4-5.9" />
              </svg>
              <span>{site.email}</span>
            </a>
          </p>
        </div>
      </div>

      {/*
        No fixed aspect ratio here on purpose — see the CSS. The image is meant
        to match the text column's height exactly, not the other way round,
        which is what keeps it from dominating the band the way a tall portrait
        crop did in the very first version of this section.
      */}
      <div class="find__media">
        <Picture
          src={galleryPhoto(photo.file)}
          formats={['avif', 'webp']}
          widths={[500, 800, 1100]}
          sizes="(min-width: 55rem) 50vw, 100vw"
          alt={t(locale, `gallery.${photo.id}.alt`)}
          data-i18n-alt={`gallery.${photo.id}.alt`}
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </div>
</section>
