---
import { Picture } from 'astro:assets';
import { t, defaultLocale, type Locale } from '../lib/i18n';
import { galleryPhoto } from '../lib/photos';
import site from '../data/site.json';
import gallery from '../data/gallery.json';

interface Props {
  locale?: Locale;
}
const { locale = defaultLocale } = Astro.props;

/* Looked up by filename; the id still drives the alt text, so the caption
   follows the photo without anything here restating it. */
const FIND_US_PHOTO = 'dsc-8248.jpg';
const photo = gallery.images.find((image) => image.file === FIND_US_PHOTO);
if (!photo) {
  throw new Error(
    `Where to Find Us wants ${FIND_US_PHOTO}, which has no entry in data/gallery.json. ` +
      `Add one (with alt text in both locales) before pointing the section at it.`
  );
}

const dayOrder = [
  'Monday',
  'Tuesday',
  'Wednesday',
  'Thursday',
  'Friday',
  'Saturday',
  'Sunday',
] as const;

/**
 * Collapses each entry's days into CONTIGUOUS runs. Computed rather than taken
 * as an entry's first and last day: an entry listing Tuesday and Thursday would
 * otherwise render "Tue – Thu" and claim a Wednesday the restaurant is shut.
 * Non-contiguous days become separate rows.
 */
function runsOf(days: readonly string[]) {
  const indices = days
    .map((day) => dayOrder.indexOf(day as (typeof dayOrder)[number]))
    .filter((i) => i >= 0)
    .sort((a, b) => a - b);

  const runs: { from: string; to: string }[] = [];
  let start = -1;
  let previous = -Infinity;
  for (const i of indices) {
    if (i !== previous + 1) {
      if (start >= 0) runs.push({ from: dayOrder[start], to: dayOrder[previous] });
      start = i;
    }
    previous = i;
  }
  if (start >= 0) runs.push({ from: dayOrder[start], to: dayOrder[previous] });
  return runs;
}

const dayIndex = (day: string) => dayOrder.indexOf(day as (typeof dayOrder)[number]);

/*
  Every run, open and closed, ordered by the day it starts on, so the list reads
  as a week. Sorting by dayIndex rather than by open-vs-closed is what lets the
  closed day move — nothing here assumes which day is shut, or that any is. A
  shut day is still listed; dropping it leaves a visitor guessing.
*/
const schedule = [
  ...site.hours.entries.flatMap((entry) =>
    runsOf(entry.days).map((run) => ({ run, opens: entry.opens, closes: entry.closes }))
  ),
  ...runsOf(site.hours.closed).map((run) => ({ run, opens: null, closes: null })),
].sort((a, b) => dayIndex(a.run.from) - dayIndex(b.run.from));
---

<section class="section section-dark" id="find-us">
  <div class="wrap">
    {/*
      The heading is centred over the whole band rather than inside a column,
      where it would read as a column label. Its own data-reveal brings it in a
      beat ahead of the columns.
    */}
    {/*
      Not .section-head: that sets --step-3 and this is --step-2 to match the
      other band headings. Equal specificity, so overriding would depend on
      source order.
    */}
    <header class="find__head" data-reveal>
      <h2 data-i18n="findUs.heading">{t(locale, 'findUs.heading')}</h2>
    </header>

    {/*
      One text column — address, hours, phone, email, the same order it stacks
      in below the breakpoint — beside the photograph. See .find__col and
      .find__media.
    */}
    <div class="find__grid" data-reveal>
      <div class="find__col">
        <div class="find__block">
          <p class="find__label" data-i18n="findUs.addressLabel">
            {t(locale, 'findUs.addressLabel')}
          </p>
          {/*
            Street and city only. The postcode and country are in the Restaurant
            JSON-LD, which is what local search reads.
          */}
          {/*
            The address IS the map link; there is no separate "view on map"
            button (added and removed twice — the affordance it existed for is
            answered by the underline instead).

            findUs.viewOnMap is carried as .sr-only text inside the link rather
            than as an aria-label, which keeps the visible words inside the
            accessible name (WCAG 2.5.3 Label in Name) — a speech user saying
            "Laskou 3" still matches the link.

            The mapUrl guard stays: with no URL the address renders as plain
            text rather than a control that goes nowhere. That URL is a Place ID
            and must never be hand-edited — see CLAUDE.md.
          */}
          <address class="find__address">
            {site.mapUrl ? (
              <a class="find__map" href={site.mapUrl} target="_blank" rel="noopener">
                <svg class="find__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                  <path d="M12 21c4-4.2 6.5-7.4 6.5-10.5a6.5 6.5 0 1 0-13 0C5.5 13.6 8 16.8 12 21z" />
                  <circle cx="12" cy="10.5" r="2.4" />
                </svg>
                <span>
                  <span data-i18n="site.street">{t(locale, 'site.street')}</span>{' '}
                  <span data-i18n="site.city">{t(locale, 'site.city')}</span>
                </span>
                <span class="sr-only" data-i18n="findUs.viewOnMap">
                  {' '}
                  {t(locale, 'findUs.viewOnMap')}
                </span>
              </a>
            ) : (
              <Fragment>
                <span data-i18n="site.street">{t(locale, 'site.street')}</span>{' '}
                <span data-i18n="site.city">{t(locale, 'site.city')}</span>
              </Fragment>
            )}
          </address>
        </div>

        <div class="find__block">
          <p class="find__label" data-i18n="findUs.hoursLabel">{t(locale, 'findUs.hoursLabel')}</p>
          <ul class="find__hours">
            {
              schedule.map(({ run, opens, closes }) => (
                <li>
                  {/*
                    The key goes on the inner spans, never the wrapper: the
                    language switch assigns textContent, so a data-i18n parent
                    would wipe the day names nested inside it.
                  */}
                  <span>
                    <span data-i18n={`hours.${run.from}`}>
                      {t(locale, `hours.${run.from}`)}
                    </span>
                    {run.to !== run.from && (
                      <Fragment>
                        {' '}
                        <span data-i18n="hours.rangeSeparator">
                          {t(locale, 'hours.rangeSeparator')}
                        </span>{' '}
                        <span data-i18n={`hours.${run.to}`}>
                          {t(locale, `hours.${run.to}`)}
                        </span>
                      </Fragment>
                    )}
                  </span>
                  {opens ? (
                    <span>
                      {opens}
                      <span data-i18n="hours.rangeSeparator">{t(locale, 'hours.rangeSeparator')}</span>
                      {closes}
                    </span>
                  ) : (
                    <span data-i18n="findUs.closed">{t(locale, 'findUs.closed')}</span>
                  )}
                </li>
              ))
            }
          </ul>
        </div>

        <div class="find__block">
          <p class="find__label" data-i18n="contact.phoneLabel">
            {t(locale, 'contact.phoneLabel')}
          </p>
          {/*
            Icons are inline SVG in the SocialLinks idiom (24x24, fill none,
            stroke currentColor at 1.6) rather than Font Awesome: the site
            self-hosts everything, three glyphs do not justify a webfont, FA Free
            carries an attribution requirement nothing here satisfies, and inline
            SVG inherits currentColor. All aria-hidden — the link text is already
            the accessible name.
          */}
          <p class="find__contact">
            <a href={`tel:${site.phone.href}`}>
              <svg class="find__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                <path d="M6.5 3h3l1.5 4-2 1.5a12 12 0 0 0 5.5 5.5L16 12l4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.5 5.2 2 2 0 0 1 6.5 3z" />
              </svg>
              <span>{site.phone.display}</span>
            </a>
          </p>
        </div>

        {/*
          Email is its own .find__block rather than a second label in the phone
          block, so every group in the column spaces the same way.
        */}
        <div class="find__block">
          <p class="find__label" data-i18n="contact.emailLabel">
            {t(locale, 'contact.emailLabel')}
          </p>
          <p class="find__contact">
            <a href={`mailto:${site.email}`}>
              <svg class="find__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                <rect x="3" y="5" width="18" height="14" rx="2" />
                <path d="m3.6 6.6 8.4 5.9 8.4-5.9" />
              </svg>
              <span>{site.email}</span>
            </a>
          </p>
        </div>
      </div>

      {/*
        No fixed aspect ratio here on purpose — see the CSS. The image matches
        the text column's height, not the other way round, which is what keeps
        it from dominating the band.
      */}
      <div class="find__media">
        <Picture
          src={galleryPhoto(photo.file)}
          formats={['avif', 'webp']}
          widths={[500, 800, 1100]}
          sizes="(min-width: 55rem) 50vw, 100vw"
          alt={t(locale, `gallery.${photo.id}.alt`)}
          data-i18n-alt={`gallery.${photo.id}.alt`}
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </div>
</section>
