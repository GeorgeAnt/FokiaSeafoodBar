---
import MenuItem from './MenuItem.astro';
import type { MenuGroup } from '../lib/menu';
import { t, defaultLocale, type Locale } from '../lib/i18n';

interface Props {
  category: MenuGroup;
  locale?: Locale;
}
const { category, locale = defaultLocale } = Astro.props;
const name = t(locale, `menu.category.${category.id}.name`);
const unit = category.unit ? t(locale, `menu.category.${category.id}.unit`) : null;
---

<section class="menu__category" id={`cat-${category.id}`}>
  <header class="menu__category-head">
    <h2 data-i18n={`menu.category.${category.id}.name`}>{name}</h2>
    {unit && (
      <span class="menu__category-unit" data-i18n={`menu.category.${category.id}.unit`}>
        {unit}
      </span>
    )}
  </header>

  {
    /* Ternary, not `&&`. A zero-length array is `0`, which Astro renders as the
       text "0" — emptying a category's items in the JSON would print a stray
       digit on the menu rather than nothing. `undefined` short-circuits
       cleanly, so this only bites the case the client can actually create. */
    category.items?.length ? (
      <ul>
        {category.items.map((item) => (
          <MenuItem item={item} locale={locale} />
        ))}
      </ul>
    ) : null
  }

  {
    /* Κρασί splits into Ποτήρι and Φιάλη. Nothing else uses subcategories, but
       the renderer handles them generically so the client can add more. */
    category.subcategories?.map((sub) => (
      <>
        <h3 class="menu__subhead" data-i18n={`menu.category.${sub.id}.name`}>
          {t(locale, `menu.category.${sub.id}.name`)}
        </h3>
        <ul>
          {(sub.items ?? []).map((item) => (
            <MenuItem item={item} locale={locale} />
          ))}
        </ul>
      </>
    ))
  }
</section>
