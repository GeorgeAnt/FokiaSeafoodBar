---
import { Picture } from 'astro:assets';
import { t, defaultLocale, type Locale } from '../lib/i18n';
import { galleryPhoto, sushiEvents } from '../lib/photos';
import gallery from '../data/gallery.json';
import site from '../data/site.json';

interface Props {
  locale?: Locale;
}
const { locale = defaultLocale } = Astro.props;

/*
  Photos are chosen by gallery id, never by position: gallery.json is ordered
  for the gallery, and reordering it must not change what the homepage shows.
  Throws at build time rather than rendering a gap.
*/
function fromGallery(id: string, whose: string) {
  const image = gallery.images.find((candidate) => candidate.id === id);
  if (!image) {
    throw new Error(
      `${whose} wants the gallery image "${id}", which has no entry in ` +
        `data/gallery.json. Add one (with alt text in both locales), or point ` +
        `Contact.astro at an id that exists.`
    );
  }
  return { ...image, src: galleryPhoto(image.file), altKey: `gallery.${image.id}.alt` };
}

/*
  Each card is one control that places one call: the whole card is an
  <a href="tel:…">, so it has to commit to one number before the tap.

  swaps: true is that decision. The server renders the landline — correct during
  service and answered outside it — and the script below swaps in the mobile
  when the restaurant is shut. Take away does not swap: it can only be done
  during service. Ask what the call is FOR, not which row the card is in.
*/
const PANELS = [
  { id: 'table-setting', titleKey: 'contact.reserveTitle', swaps: true },
  { id: 'takeaway-box', titleKey: 'contact.takeawayTitle', swaps: false },
];

const panels = PANELS.map(({ id, titleKey, swaps }) => ({
  ...fromGallery(id, 'PANELS in Contact.astro'),
  titleKey,
  swaps,
}));

/* The schedule is handed to the client as-is rather than restated, so the
   after-hours swap can never disagree with the hours Find Us renders. */
const schedule = JSON.stringify(site.hours.entries);

/*
  Every dialling control that can swap carries the same four attributes, written
  once and spread. Two kinds of card disagreeing about which number they offer
  is the worst failure this section can have, and it would look fine on screen.
*/
const swapAttrs = {
  'data-phone-swap': '',
  'data-hours': schedule,
  'data-after-href': `tel:${site.phoneAfterHours.href}`,
  'data-after-display': site.phoneAfterHours.display,
};

/*
  The two service notes. They swap and take away does not — a party enquiry or a
  special order is the kind of call someone makes at midnight.

  Neither photograph is used elsewhere on the homepage: toast-outdoors is Our
  Goal's and sushi-board-overhead is one of the four plates directly above this
  band, so check Goal.astro and Plates.astro before changing an id here.
*/
/*
  The events photograph is a named export from lib/photos.ts rather than a
  gallery id, because the client did not want it as a tile on /gallery and every
  gallery.json entry renders there. Dropping it into gallery/ unlisted is wrong:
  npm run check walks that folder and would report it as unused.
*/
const NOTES = [
  { key: 'contact.events', titleKey: 'contact.eventsTitle', photo: sushiEvents },
  { key: 'contact.sourcing', titleKey: 'contact.sourcingTitle', id: 'oysters-on-ice' },
];

const notes = NOTES.map(({ id, key, titleKey, photo }) =>
  photo
    ? { key, titleKey, src: photo }
    : { ...fromGallery(id!, 'NOTES in Contact.astro'), key, titleKey }
);
---

{/*
  Charcoal like every band below the hero — and this is where that costs most:
  From the kitchen sits directly above as four plates on a dark ground, and the
  strip of light that used to separate the two photo groups is gone. What keeps
  them apart now is .section-dark's 1px hairline plus these cards staying inset
  rather than full-bleed. A ninth photograph in this neighbourhood is the thing
  to argue about.
*/}
<section class="section section-dark" id="contact">
  <div class="wrap">
    {/*
      Renders nav.contact, not a heading key of its own: the nav label and the
      title are the same two words, and this codebase already deleted
      goal.heading rather than keep two keys holding identical text.
    */}
    <header class="contact__head" data-reveal>
      <h2 data-i18n="nav.contact">{t(locale, 'nav.contact')}</h2>
      <p data-i18n="contact.intro">{t(locale, 'contact.intro')}</p>
    </header>

    <div class="contact__panels" data-reveal>
      {
        panels.map((panel) => (
          <a
            class="contact__panel"
            href={`tel:${site.phone.href}`}
            {...(panel.swaps ? swapAttrs : {})}
          >
            {/*
              alt="" because the whole card is a link: everything inside an <a>
              is concatenated into its accessible name, so a descriptive alt
              would prepend a sentence about a table setting to the name a
              screen-reader user hears before deciding to place a call. On
              /gallery the same photograph keeps its real alt.
            */}
            <Picture
              src={panel.src}
              formats={['avif', 'webp']}
              widths={[400, 600, 900]}
              sizes="(min-width: 48rem) 26rem, 100vw"
              alt=""
              loading="lazy"
              decoding="async"
            />
            <span class="contact__panel-body">
              <span class="contact__panel-title" data-i18n={panel.titleKey}>
                {t(locale, panel.titleKey)}
              </span>
              {/*
                The number is shown, not just dialled: a control whose target is
                invisible gives a visitor nothing to check before tapping, and
                one whose JS never ran would not know it is offering the
                landline. The icon is the SocialLinks / FindUs idiom and is
                aria-hidden. A phone, never an arrow — an arrow says "goes
                somewhere" and this places a call; the circular badge is what
                answers the "doesn't read as a button" complaint instead.
              */}
              <span class="contact__panel-call">
                <span class="contact__phone-badge">
                  <svg class="contact__phone-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                    <path d="M6.5 3h3l1.5 4-2 1.5a12 12 0 0 0 5.5 5.5L16 12l4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.5 5.2 2 2 0 0 1 6.5 3z" />
                  </svg>
                </span>
                <span class="contact__phone-number">{site.phone.display}</span>
              </span>
            </span>
          </a>
        ))
      }
    </div>

    {/*
      Cards too, at the client's request, but deliberately not the SAME card.

      The picture is above the text, not behind it: .contact__panel's scrim is a
      fixed-length ramp sized for two short bold lines owing 3:1, and these are
      ~60-word paragraphs owing 4.5:1. On a flat --black panel the copy is
      --light-stone at 6.55:1 with no scrim to measure.

      The card is not a link; the call inside it is — so the link's name stays
      "Τηλέφωνο 21 3099 1571" rather than swallowing the paragraph.
    */}
    <div class="contact__notes" data-reveal>
      {
        notes.map((note) => (
          /*
            A native <details> — there is no script behind these cards. It
            opens, keyboards and announces its expanded state without JS, and
            the paragraph is real DOM throughout. Do not "upgrade" it to a
            button and a class toggle: strictly more code, strictly less robust.
          */
          <details class="contact__note">
            {/*
              The summary is the entire closed card, which is why this
              photograph is alt="": everything inside a control is concatenated
              into its accessible name. Same rule the panels follow.
            */}
            <summary class="contact__note-summary">
              <Picture
                src={note.src}
                formats={['avif', 'webp']}
                widths={[400, 600, 900]}
                sizes="(min-width: 48rem) 26rem, 100vw"
                alt=""
                loading="lazy"
                decoding="async"
              />
              <span class="contact__note-head">
                <span class="contact__note-title" data-i18n={note.titleKey}>
                  {t(locale, note.titleKey)}
                </span>
                {/*
                  An arrow where the panels carry a phone: these cards do go
                  somewhere — they open — so it is right here for the reason it
                  was wrong there. Two glyphs, not one rotated: a chevron turned
                  a quarter circle points down, which is what a CLOSED
                  disclosure wears.
                */}
                <span class="contact__note-cue" aria-hidden="true">
                  <svg class="contact__note-cue-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                    <path d="M9 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  <svg class="contact__note-cue-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                    <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </span>
            </summary>

            {/*
              The film is near-opaque rather than a gradient, which is what makes
              this layout possible: the copy sits on what is effectively a flat
              surface, so it measures like text on a panel, not on a picture.
            */}
            <div class="contact__note-film">
              <p class="contact__note-text" data-i18n={note.key}>
                {t(locale, note.key)}
              </p>
              {/*
                The same badge-and-number control the panels carry, swapping on
                the clock. The .sr-only label is there because the visible text
                is bare digits — a link named "21 3099 1571" says nothing out of
                context. It reuses contact.phoneLabel, and prefixing keeps the
                visible number inside the accessible name (WCAG 2.5.3).
              */}
              <a class="contact__note-call" href={`tel:${site.phone.href}`} {...swapAttrs}>
                <span class="sr-only" data-i18n="contact.phoneLabel">
                  {t(locale, 'contact.phoneLabel')}
                </span>
                <span class="contact__phone-badge">
                  <svg class="contact__phone-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                    <path d="M6.5 3h3l1.5 4-2 1.5a12 12 0 0 0 5.5 5.5L16 12l4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.5 5.2 2 2 0 0 1 6.5 3z" />
                  </svg>
                </span>
                <span class="contact__phone-number">{site.phone.display}</span>
              </a>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Outside opening hours the swapping cards dial the mobile instead of the
  // landline, and show the number they will dial.
  //
  // Evaluated in Europe/Athens, never the visitor's timezone: someone calling
  // from London at 22:00 is calling a restaurant where it is already midnight.
  // Intl does the conversion, so no offset is hard-coded and DST is handled.
  //
  // The decision lives in lib/hours.ts so the shipped logic is testable. This
  // script rewrites the href and the digits TOGETHER — they must never
  // disagree, since the digits are all a visitor can check before tapping.
  //
  // It selects on [data-phone-swap], spread from one object in the frontmatter.
  // An earlier version looked for a hand-typed id that had stopped being
  // rendered, so the swap silently did nothing and nothing caught it. The
  // attribute belongs on the anchor that dials, never on the card: on a panel
  // they are the same element, on a note card they are not.
  import { isOpenAt, type HoursEntry } from '../lib/hours';

  const cards = document.querySelectorAll<HTMLAnchorElement>('[data-phone-swap]');

  if (cards.length) {
    const athensNow = () => {
      const parts = new Intl.DateTimeFormat('en-GB', {
        timeZone: 'Europe/Athens',
        weekday: 'long',
        hour: '2-digit',
        minute: '2-digit',
        hourCycle: 'h23',
      }).formatToParts(new Date());
      const get = (type: string) => parts.find((p) => p.type === type)?.value ?? '';
      return { day: get('weekday'), minutes: Number(get('hour')) * 60 + Number(get('minute')) };
    };

    const { day, minutes } = athensNow();

    cards.forEach((card) => {
      try {
        const entries: HoursEntry[] = JSON.parse(card.dataset.hours || '[]');
        if (isOpenAt(entries, day, minutes)) return;

        const href = card.dataset.afterHref;
        const display = card.dataset.afterDisplay;
        const numberEl = card.querySelector('.contact__phone-number');
        if (!href || !display || !numberEl) return;

        card.setAttribute('href', href);
        numberEl.textContent = display;
      } catch {
        // Any failure leaves this card on the landline, which is the correct
        // number during service and a working number outside it.
      }
    });
  }

</script>
