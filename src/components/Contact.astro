---
import { Picture } from 'astro:assets';
import { t, defaultLocale, type Locale } from '../lib/i18n';
import { galleryPhoto } from '../lib/photos';
import gallery from '../data/gallery.json';
import site from '../data/site.json';

interface Props {
  locale?: Locale;
}
const { locale = defaultLocale } = Astro.props;

/*
  Photos are chosen by gallery id, not by filename or position, for the same
  reason Plates does it: gallery.json is ordered for the gallery, and reordering
  it must not quietly change what the homepage shows. The alt text comes from
  that entry too, so it stays written in one place and in both locales.
*/
/*
  Both numbers are on the page at once, each labelled with the window it
  answers in. Reservations takes both; take away takes the landline only.

  This replaced a clock-driven swap that showed one number at a time — the
  landline during service, the mobile after it, decided in Europe/Athens from
  `site.hours.entries`. The client asked for both to be visible, which leaves
  that machinery with nothing to decide: there is no longer a single slot whose
  contents depend on the hour. The label is what tells a visitor which to ring,
  and it does so at 3am with JavaScript off, which the swap never could.

  Take away keeps one number because it can only be done during service. A
  second number there would be a promise the restaurant cannot keep, so the
  asymmetry is the point and not an oversight.

  **And that one number carries no label**, which is the same rule as the
  asymmetry above rather than an inconsistency with it. A label here says *which
  of these to ring* — it only means something where there is a choice. On
  reservations there are two numbers and the labels are the entire way of telling
  them apart; on take away there is one, and it can only ever be rung during
  service, so "Εντός ωραρίου" would be answering a question nobody asked. That is
  the eyebrow rule from CLAUDE.md applied one more time: a label earns its place
  by saying something not already implied.

  `whenKey` is therefore optional, and its absence is the instruction.
*/
const PANELS = [
  {
    id: 'table-setting',
    titleKey: 'contact.reserveTitle',
    numbers: [
      { ...site.phone, whenKey: 'contact.duringHours' },
      { ...site.phoneAfterHours, whenKey: 'contact.afterHours' },
    ],
  },
  {
    id: 'takeaway-box',
    titleKey: 'contact.takeawayTitle',
    numbers: [{ ...site.phone, whenKey: undefined as string | undefined }],
  },
];

const panels = PANELS.map(({ id, titleKey, numbers }) => {
  const image = gallery.images.find((candidate) => candidate.id === id);
  if (!image) {
    throw new Error(
      `Take away wants the gallery image "${id}", which has no entry in ` +
        `data/gallery.json. Add one (with alt text in both locales), or point ` +
        `PANELS in Contact.astro at an id that exists.`
    );
  }
  return {
    ...image,
    titleKey,
    numbers,
    src: galleryPhoto(image.file),
    altKey: `gallery.${image.id}.alt`,
  };
});
---

{/*
  Charcoal, like every band below the hero — and this is the band where that
  decision costs the most, so it is worth being explicit about.

  This section was light *specifically* to keep two photo bands apart: From the
  kitchen sits directly above it as four plates on a dark ground, and the strip
  of light around these two inset panels was the boundary between the two photo
  groups. That strip is gone. What separates them now is the 1px hairline
  .section-dark puts on top of this section, which is a thinner boundary than a
  whole tier change — a deliberate trade, not an oversight. The panels stay
  inset rather than full-bleed, which is what keeps the two groups from reading
  as one continuous run of photographs.

  The panel titles are unaffected: they were never carried by the band, only by
  .contact__panel::before, the gradient scrim over each photo.

  The section heading is .sr-only: it carries the combined nav label so the
  outline and the /#contact anchor still have a heading, while the two panel
  titles say each half once.
*/}
<section class="section section-dark" id="contact">
  <div class="wrap">
    <h2 class="sr-only" data-i18n="contact.heading">{t(locale, 'contact.heading')}</h2>

    <div class="contact__panels" data-reveal>
      {
        panels.map((panel) => (
          <article class="contact__panel">
            <Picture
              src={panel.src}
              formats={['avif', 'webp']}
              widths={[500, 800, 1200]}
              sizes="(min-width: 48rem) 45vw, 100vw"
              alt={t(locale, panel.altKey)}
              data-i18n-alt={panel.altKey}
              loading="lazy"
              decoding="async"
            />
            <div class="contact__panel-body">
              <h3 class="contact__panel-title" data-i18n={panel.titleKey}>
                {t(locale, panel.titleKey)}
              </h3>
              {/*
                A list because it is one: on reservations it is two numbers, and
                a screen reader announcing "list of 2" before them is the whole
                point being made visually by putting them one above the other.

                The "when" label, where there is one, is *inside* the link rather
                than beside it. Outside, a screen reader would read it once as
                loose text and again inside the link's name; inside, it is said
                once and the whole row — label, icon, digits, arrow — is a single
                44px target.

                Three links on the page would otherwise all read as bare digits
                with nothing to tell them apart (WCAG 2.4.4), and the take away
                one is the *same* number as the reservations landline, so it is
                not enough for the digits to differ. The panel title is added as
                .sr-only text, which is what makes every name distinct: "Κλείστε
                τη θέση σας Εντός ωραρίου 21 3099 1571" against "Take away 21
                3099 1571". Appended rather than an aria-label, so the visible
                digits stay inside the accessible name and 2.5.3 (Label in Name)
                still holds.

                Icons are inline SVG in the SocialLinks / FindUs idiom — 24x24,
                fill none, stroke currentColor at 1.6 — and aria-hidden, since
                the text beside them is already the name.
              */}
              <ul class="contact__phones">
                {panel.numbers.map((number) => (
                  <li>
                    <a class="contact__phone" href={`tel:${number.href}`}>
                      <span class="sr-only" data-i18n={panel.titleKey}>
                        {t(locale, panel.titleKey)}
                      </span>
                      {number.whenKey ? (
                        <span class="contact__phone-when" data-i18n={number.whenKey}>
                          {t(locale, number.whenKey)}
                        </span>
                      ) : null}
                      <span class="contact__phone-call">
                        <svg class="contact__phone-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                          <path d="M6.5 3h3l1.5 4-2 1.5a12 12 0 0 0 5.5 5.5L16 12l4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.5 5.2 2 2 0 0 1 6.5 3z" />
                        </svg>
                        <span class="contact__phone-number">{number.display}</span>
                        <svg class="contact__phone-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                          <path d="M4 12h14" />
                          <path d="m12.5 6 6 6-6 6" />
                        </svg>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>

    <div class="contact__notes" data-reveal>
      <p data-i18n="contact.events">{t(locale, 'contact.events')}</p>
      <p data-i18n="contact.sourcing">{t(locale, 'contact.sourcing')}</p>
    </div>
  </div>
</section>
