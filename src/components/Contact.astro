---
import { t, defaultLocale, type Locale } from '../lib/i18n';
import site from '../data/site.json';

interface Props {
  locale?: Locale;
}
const { locale = defaultLocale } = Astro.props;

/* Reservations and take away are the same phone call, and the heading now names
   both, so the section is the heading and the number — the two description cards
   that used to sit under it only restated the heading at length. */
---

{/*
  Light tier, not dark, and that is a consequence of where the band now sits.

  From the kitchen moved above this section and is black, because food
  photography needs the dark ground. Two dark bands cannot run together, and of
  the two this is the one that gives: it is text only, which is exactly what the
  lighter tiers suit, while the photographs have nowhere else to go. The phone
  number is `--wood` on salt here rather than `--wood-light` on black — 6.6:1,
  and the brand red rather than its dark-tier tint.

  Heading and number side by side, not stacked.

  Stacked in a full-width band this was a heading, a label and a phone number in
  the left third with the rest of a black screen empty beside them — the band
  read as a gap in the page rather than as a section. Set against each other on
  one line they fill the row, the band loses about half its height, and the
  number lands at the end of the line where the eye finishes.
*/}
<section class="section section--tight" id="contact">
  <div class="wrap contact__inner">
    <header class="section-head section-head--inline" data-reveal>
      <h2 data-i18n="contact.heading">{t(locale, 'contact.heading')}</h2>
    </header>

    <p class="contact__call" data-reveal>
      <span class="contact__call-label" data-i18n="contact.callUs">{t(locale, 'contact.callUs')}</span>
      <a class="contact__phone" href={`tel:${site.phone.href}`}>
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          width="22"
          height="22"
          aria-hidden="true"
        >
          <path
            d="M6.5 3h3l1.5 4-2 1.5a12 12 0 0 0 5.5 5.5l1.5-2 4 1.5v3a2 2 0 0 1-2.2 2A17 17 0 0 1 4.5 5.2 2 2 0 0 1 6.5 3Z"
            stroke-linejoin="round"
          />
        </svg>
        {site.phone.display}
      </a>
    </p>
  </div>
</section>
