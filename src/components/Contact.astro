---
import { Picture } from 'astro:assets';
import { t, defaultLocale, type Locale } from '../lib/i18n';
import { galleryPhoto, sushiEvents } from '../lib/photos';
import gallery from '../data/gallery.json';
import site from '../data/site.json';

interface Props {
  locale?: Locale;
}
const { locale = defaultLocale } = Astro.props;

/*
  Photos are chosen by gallery id, not by filename or position, for the same
  reason Plates does it: gallery.json is ordered for the gallery, and reordering
  it must not quietly change what the homepage shows. It throws at build time
  rather than rendering a gap.

  Both card sets in this band go through here, but they do **not** treat the alt
  text the same way, and the difference is not an inconsistency — see the notes
  on each block of markup. The panels are links, so their photographs are
  decorative and carry alt=""; the note cards are not, so theirs are content and
  carry the gallery's real, translated alt.
*/
function fromGallery(id: string, whose: string) {
  const image = gallery.images.find((candidate) => candidate.id === id);
  if (!image) {
    throw new Error(
      `${whose} wants the gallery image "${id}", which has no entry in ` +
        `data/gallery.json. Add one (with alt text in both locales), or point ` +
        `Contact.astro at an id that exists.`
    );
  }
  return { ...image, src: galleryPhoto(image.file), altKey: `gallery.${image.id}.alt` };
}

/*
  Each card is one control that places one call.

  The client asked for the panels to behave as buttons, so the whole card is an
  <a href="tel:…"> rather than a photo with a link somewhere inside it. That
  forces the question the previous version dodged by showing both numbers at
  once: a control that dials has to know *which* number, and it has to decide
  before the visitor taps.

  `swaps: true` is that decision. The server renders the landline — correct
  during service, and a number that is answered outside it — and the script
  below replaces it with the mobile when the restaurant is shut, evaluated on the
  restaurant's clock. Take away does not swap: it can only be done during
  service, so the landline is the only number it could ever want.
*/
const PANELS = [
  { id: 'table-setting', titleKey: 'contact.reserveTitle', swaps: true },
  { id: 'takeaway-box', titleKey: 'contact.takeawayTitle', swaps: false },
];

const panels = PANELS.map(({ id, titleKey, swaps }) => ({
  ...fromGallery(id, 'PANELS in Contact.astro'),
  titleKey,
  swaps,
}));

/* The schedule is handed to the client as-is rather than restated, so the
   after-hours swap can never disagree with the hours Find Us renders. */
const schedule = JSON.stringify(site.hours.entries);

/*
  Every dialling control that can swap carries the same four attributes, so they
  are written once here and spread rather than repeated per card. Two kinds of
  card disagreeing about which number they offer is the worst failure this
  section can have — it would look perfectly fine on screen — and one object is
  what makes that impossible rather than merely unlikely.
*/
const swapAttrs = {
  'data-phone-swap': '',
  'data-hours': schedule,
  'data-after-href': `tel:${site.phoneAfterHours.href}`,
  'data-after-display': site.phoneAfterHours.display,
};

/*
  The two service notes — private events and special sourcing.

  They swap, and take away still does not, which is the same rule applied to
  three different cards rather than an inconsistency: take away can only be done
  during service, so the landline is the only number it could ever want, while a
  party enquiry or a special order is exactly the kind of call someone makes at
  midnight. Both of these paragraphs ask to be contacted; neither is bound to a
  service window.

  The photographs are picked against the copy, not for variety, and both are the
  client's own choices. `sushi-events.jpg` is a service being plated — trays of
  rolls laid out in quantity — which is what "προγραμματίσουμε τη δική σου
  εκδήλωση" is offering. `oysters-on-ice` is the sourcing card: the paragraph is
  about getting hold of something particular, and oysters are the most legible
  instance of that on the whole site.

  Neither is used anywhere else on the homepage. When the events card was still
  drawing from the gallery, `toast-outdoors` was the obvious pick for it and is
  already Our Goal's photograph, and
  `sushi-board-overhead` is one of the four plates directly above this band —
  check both before changing an id here.
*/
/*
  The events card's photograph does not come from the gallery and the sourcing
  card's does, which is the one asymmetry in this band worth explaining.

  `sushi-events.jpg` is the client's own shot of a service being plated, and
  they did not want it as a tile on /gallery — so it is a named export from
  lib/photos.ts with its alt in the locale files, rather than an id looked up in
  gallery.json. See the note on `sushiEvents` there for why it is not simply
  dropped into `gallery/` unlisted: `npm run check` would report it as "not
  shown on the site", which would be false.

  It replaced `shared-table`, which is consequently free again.
*/
const NOTES = [
  { key: 'contact.events', titleKey: 'contact.eventsTitle', photo: sushiEvents },
  { key: 'contact.sourcing', titleKey: 'contact.sourcingTitle', id: 'oysters-on-ice' },
];

const notes = NOTES.map(({ id, key, titleKey, photo }) =>
  photo
    ? { key, titleKey, src: photo }
    : { ...fromGallery(id!, 'NOTES in Contact.astro'), key, titleKey }
);
---

{/*
  Charcoal, like every band below the hero — and this is the band where that
  decision costs the most, so it is worth being explicit about.

  This section was light *specifically* to keep two photo bands apart: From the
  kitchen sits directly above it as four plates on a dark ground, and the strip
  of light around these two inset panels was the boundary between the two photo
  groups. That strip is gone. What separates them now is the 1px hairline
  .section-dark puts on top of this section, which is a thinner boundary than a
  whole tier change — a deliberate trade, not an oversight. The cards stay
  inset rather than full-bleed, which is what keeps the two groups from reading
  as one continuous run of photographs — and now that they are small and heavily
  rounded, they read as controls rather than as photography at all.

  The heading is visible now. It was `.sr-only` for as long as this band had no
  title of its own — it carried the combined nav label, "Κλείστε τη θέση σας •
  Take away", purely so the outline and the /#contact anchor had a heading, and
  showing *that* string was never an option: it is word for word the two panel
  titles directly beneath it, which is the two-titles-stacked failure the eyebrow
  note in CLAUDE.md is entirely about. New copy is what made a visible heading
  possible, not a change of mind about hiding it.
*/}
<section class="section section-dark" id="contact">
  <div class="wrap">
    {/*
      Heading plus one line, the same shape .plates__head has — this was the only
      band below the hero without a visible title, so it is joining the pattern
      rather than inventing one.

      **It renders `nav.contact`, not a heading key of its own.** The nav label
      and the title are now the same two words, and this codebase has already
      decided that case once: `goal.heading` was deleted rather than kept beside
      `nav.goal` holding identical text. `contact.heading` went the same way here.
      Change the words in one place and the nav follows, which is the point.

      The intro names the four services rather than explaining how to work the
      cards. Saying "tap to see more" would have been wrong about half of them —
      only the two note cards open; the panels dial on tap — and the arrows
      already say which is which.
    */}
    <header class="contact__head" data-reveal>
      <h2 data-i18n="nav.contact">{t(locale, 'nav.contact')}</h2>
      <p data-i18n="contact.intro">{t(locale, 'contact.intro')}</p>
    </header>

    <div class="contact__panels" data-reveal>
      {
        panels.map((panel) => (
          <a
            class="contact__panel"
            href={`tel:${site.phone.href}`}
            {...(panel.swaps ? swapAttrs : {})}
          >
            {/*
              alt="" on purpose, and it is the whole card being a link that makes
              it right. Everything inside an <a> is concatenated into the link's
              accessible name, so the gallery's descriptive alt would prepend a
              sentence about a table setting to "Κλείστε τη θέση σας 21 3099
              1571" — the name a screen-reader user hears before deciding whether
              to place a call. The picture illustrates the title; it does not
              identify the control. On /gallery the same photograph keeps its
              real alt, because there it is the content.
            */}
            <Picture
              src={panel.src}
              formats={['avif', 'webp']}
              widths={[400, 600, 900]}
              sizes="(min-width: 48rem) 26rem, 100vw"
              alt=""
              loading="lazy"
              decoding="async"
            />
            <span class="contact__panel-body">
              <span class="contact__panel-title" data-i18n={panel.titleKey}>
                {t(locale, panel.titleKey)}
              </span>
              {/*
                The number is shown, not just dialled. A control whose target is
                invisible gives a visitor nothing to check before tapping, and a
                visitor whose JavaScript never ran would otherwise have no way to
                notice that the card is offering the landline outside service.

                Icon in the SocialLinks / FindUs idiom — 24x24, fill none, stroke
                currentColor at 1.6 — and aria-hidden, since the text beside it
                is already part of the name. There is no arrow any more: an arrow
                says "goes somewhere", and this places a call. It sits inside a
                circular badge now — see the note just below — which is a
                different fix for the same "doesn't read as a button" complaint
                an arrow would otherwise have answered.
              */}
              <span class="contact__panel-call">
                {/*
                  The circle is the affordance; the glyph inside it is still a
                  phone, not an arrow. An arrow was tried and removed once
                  already — see the note above — because it says "goes
                  somewhere" and this places a call. The circle says "this is a
                  button" without changing what the icon means.
                */}
                <span class="contact__phone-badge">
                  <svg class="contact__phone-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                    <path d="M6.5 3h3l1.5 4-2 1.5a12 12 0 0 0 5.5 5.5L16 12l4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.5 5.2 2 2 0 0 1 6.5 3z" />
                  </svg>
                </span>
                <span class="contact__phone-number">{site.phone.display}</span>
              </span>
            </span>
          </a>
        ))
      }
    </div>

    {/*
      The two service notes are cards now too, at the client's request that they
      read as the pair above does. They are deliberately not the *same* card, and
      every difference is forced rather than chosen.

      **The picture is above the text, not behind it.** .contact__panel carries
      its title over the photograph on a fixed-length scrim — dense to 8rem,
      finished by 16rem — sized for two lines of --salt bold owing 3:1. These
      paragraphs are ~60 words: at --step-0 they run to six or seven lines, so
      most of the block would sit above 8rem in the thin part of that ramp, and
      body copy owes 4.5:1 rather than 3:1. The one small tinted line that ever
      sat on those cards measured 5.19:1 at its best and 3.49:1 at 390px under an
      earlier ramp — that is the margin this would have been building on. Split
      into a photograph and a flat --black panel beneath it, the copy is
      --light-stone on --black at 6.55:1 with no scrim to measure at all.

      **The card is not a link; the call inside it is.** Everything inside an <a>
      is concatenated into the link's accessible name — the reason the panel
      photographs carry alt="" — so a 60-word paragraph inside the anchor would
      be that same problem several times over. The paragraph is read, the badge
      beneath it is tapped, and the link's name stays "Τηλέφωνο 21 3099 1571".

      **Which is also why these photographs keep their real alt.** They are not
      inside a control, so there is no name to pollute; they are content in an
      editorial card, and the gallery entry already has the sentence in both
      locales. data-i18n-alt hands it to the language switch, same as Goal.
    */}
    <div class="contact__notes" data-reveal>
      {
        notes.map((note) => (
          /*
            A <details>, and that is the whole interaction — there is no script
            behind these cards at all.

            The site's other hide-and-reveal is `.has-reveal`, which exists
            because a CSS rule that hides content has to be owned by something
            that can un-hide it; the danger there is a failed script leaving the
            page at opacity 0. A native disclosure has no such failure mode. It
            opens without JS, it is keyboard-operable without JS, it announces
            its own expanded state without ARIA, and the paragraph inside is real
            DOM the whole time, so search engines and screen readers get the copy
            whether or not anyone clicks. Do not "upgrade" this to a button and a
            class toggle: that would be strictly more code and strictly less
            robust.
          */
          <details class="contact__note">
            {/*
              The summary is the entire closed card — photograph, title and cue.

              Which is exactly why the photograph is `alt=""` here, and it is the
              same rule the panels above follow rather than a second one:
              everything inside the control is concatenated into its accessible
              name, so a descriptive alt would read a sentence about plated
              sushi before the words that say what the control does. The picture
              illustrates the title; the title identifies the control. This is
              what the note cards' own real alt text was traded for when they
              stopped being passive cards and became controls.
            */}
            <summary class="contact__note-summary">
              <Picture
                src={note.src}
                formats={['avif', 'webp']}
                widths={[400, 600, 900]}
                sizes="(min-width: 48rem) 26rem, 100vw"
                alt=""
                loading="lazy"
                decoding="async"
              />
              <span class="contact__note-head">
                <span class="contact__note-title" data-i18n={note.titleKey}>
                  {t(locale, note.titleKey)}
                </span>
                {/*
                  An arrow, where the panels carry a phone — and the difference
                  is the point rather than an inconsistency.

                  CLAUDE.md records an arrow being tried on the panels and
                  removed, because an arrow says "goes somewhere" and those cards
                  place a call. These cards genuinely do go somewhere: they open.
                  So the arrow is correct here for the same reason it was wrong
                  there, and the phone glyph moves inside the film, onto the
                  thing that actually dials.

                  **Two glyphs, not one rotated one.** The arrow used to turn a
                  quarter circle when the card opened, which left a chevron
                  pointing *down* — the icon a closed disclosure conventionally
                  wears, so the open card was showing the closed card's cue. A
                  cross says "close" and nothing else. Only one of the two is
                  ever in the flow, so the disc's size never depends on which is
                  showing.
                */}
                <span class="contact__note-cue" aria-hidden="true">
                  <svg class="contact__note-cue-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                    <path d="M9 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  <svg class="contact__note-cue-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                    <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </span>
            </summary>

            {/*
              The film. Near-opaque rather than a gradient, and that is what
              makes this layout possible at all.

              These paragraphs are ~60 words. The panels' scrim is a fixed-length
              ramp sized for two short bold lines owing 3:1, and body copy owes
              4.5:1 — putting a paragraph on it is the failure this band spent a
              whole revision avoiding by stacking photo above text. A film that
              is *allowed* to hide the photograph has none of that difficulty:
              the copy sits on what is effectively a flat surface, so it measures
              like text on a panel rather than text on a picture.
            */}
            <div class="contact__note-film">
              <p class="contact__note-text" data-i18n={note.key}>
                {t(locale, note.key)}
              </p>
              {/*
                The same badge-and-number control the panels carry, so all four
                cards end at one affordance. It swaps on the clock like the
                reservations panel — see the note on NOTES above — and the href
                and the digits are rewritten together by the one script below.

                The .sr-only label is there because the visible text is bare
                digits: out of context, a link named "21 3099 1571" says nothing
                about what it does. It uses contact.phoneLabel, the key Find Us
                already renders as a visible label, so nothing new is invented
                and the switch owns both. Prefixed rather than appended, and the
                visible number stays inside the accessible name either way,
                which is what WCAG 2.5.3 asks for.
              */}
              <a class="contact__note-call" href={`tel:${site.phone.href}`} {...swapAttrs}>
                <span class="sr-only" data-i18n="contact.phoneLabel">
                  {t(locale, 'contact.phoneLabel')}
                </span>
                <span class="contact__phone-badge">
                  <svg class="contact__phone-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                    <path d="M6.5 3h3l1.5 4-2 1.5a12 12 0 0 0 5.5 5.5L16 12l4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.5 5.2 2 2 0 0 1 6.5 3z" />
                  </svg>
                </span>
                <span class="contact__phone-number">{site.phone.display}</span>
              </a>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Outside opening hours the reservations card dials the mobile instead of the
  // landline, and shows the number it will dial.
  //
  // Evaluated in Europe/Athens, never in the visitor's own timezone: someone
  // calling from London at 22:00 is calling a restaurant where it is already
  // midnight, and the number they need is the one that rings after service.
  // Intl does the conversion, so no offset is hard-coded and DST is handled.
  //
  // The decision itself lives in lib/hours.ts so the shipped logic is the logic
  // that can be tested; this script only supplies the clock and rewrites the
  // href and the digits together — they must never disagree, since the digits
  // are the only thing a visitor can check before tapping.
  //
  // It selects on [data-phone-swap], spread from one object in the frontmatter
  // onto every dialling control that can swap. An earlier version looked for a
  // hand-typed id that had stopped being rendered, so the swap silently did
  // nothing for weeks and neither `astro check` nor `npm run check` had anything
  // to catch.
  //
  // **The attribute belongs on the anchor that dials, never on the card.** On a
  // panel those are the same element — the whole card is the link. On a note
  // card they are not: the card is a <div> and the control is the small call
  // link inside it, so the attribute goes there. That keeps this query's
  // contract exact — every match is an anchor with an href to rewrite and a
  // .contact__phone-number inside it — rather than "a card, somehow".
  import { isOpenAt, type HoursEntry } from '../lib/hours';

  const cards = document.querySelectorAll<HTMLAnchorElement>('[data-phone-swap]');

  if (cards.length) {
    const athensNow = () => {
      const parts = new Intl.DateTimeFormat('en-GB', {
        timeZone: 'Europe/Athens',
        weekday: 'long',
        hour: '2-digit',
        minute: '2-digit',
        hourCycle: 'h23',
      }).formatToParts(new Date());
      const get = (type: string) => parts.find((p) => p.type === type)?.value ?? '';
      return { day: get('weekday'), minutes: Number(get('hour')) * 60 + Number(get('minute')) };
    };

    const { day, minutes } = athensNow();

    cards.forEach((card) => {
      try {
        const entries: HoursEntry[] = JSON.parse(card.dataset.hours || '[]');
        if (isOpenAt(entries, day, minutes)) return;

        const href = card.dataset.afterHref;
        const display = card.dataset.afterDisplay;
        const numberEl = card.querySelector('.contact__phone-number');
        if (!href || !display || !numberEl) return;

        card.setAttribute('href', href);
        numberEl.textContent = display;
      } catch {
        // Any failure leaves this card on the landline, which is the correct
        // number during service and a working number outside it.
      }
    });
  }

</script>
