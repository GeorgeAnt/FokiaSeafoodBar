---
import { Picture } from 'astro:assets';
import { t, defaultLocale, type Locale } from '../lib/i18n';
import { galleryPhoto } from '../lib/photos';
import gallery from '../data/gallery.json';
import site from '../data/site.json';

interface Props {
  locale?: Locale;
}
const { locale = defaultLocale } = Astro.props;

/*
  Photos are chosen by gallery id, not by filename or position, for the same
  reason Plates does it: gallery.json is ordered for the gallery, and reordering
  it must not quietly change what the homepage shows. The alt text comes from
  that entry too, so it stays written in one place and in both locales.
*/
const PANELS = [
  { id: 'table-setting', titleKey: 'contact.reserveTitle' },
  { id: 'takeaway-box', titleKey: 'contact.takeawayTitle' },
];

const panels = PANELS.map(({ id, titleKey }) => {
  const image = gallery.images.find((candidate) => candidate.id === id);
  if (!image) {
    throw new Error(
      `Take away wants the gallery image "${id}", which has no entry in ` +
        `data/gallery.json. Add one (with alt text in both locales), or point ` +
        `PANELS in Contact.astro at an id that exists.`
    );
  }
  return { ...image, titleKey, src: galleryPhoto(image.file), altKey: `gallery.${image.id}.alt` };
});

/* The schedule is handed to the client as-is rather than re-stated, so the
   after-hours swap can never disagree with the hours the section renders. */
const schedule = JSON.stringify(site.hours.entries);
---

{/*
  Charcoal, like every band below the hero — and this is the band where that
  decision costs the most, so it is worth being explicit about.

  This section was light *specifically* to keep two photo bands apart: From the
  kitchen sits directly above it as four plates on a dark ground, and the strip
  of light around these two inset panels was the boundary between the two photo
  groups. That strip is gone. What separates them now is the 1px hairline
  .section-dark puts on top of this section, which is a thinner boundary than a
  whole tier change — a deliberate trade, not an oversight. The panels stay
  inset rather than full-bleed, which is what keeps the two groups from reading
  as one continuous run of photographs.

  The panel titles are unaffected: they were never carried by the band, only by
  .contact__panel::before, the gradient scrim over each photo.

  The section heading is .sr-only: it carries the combined nav label so the
  outline and the /#contact anchor still have a heading, while the two panel
  titles say each half once.
*/}
<section class="section section-dark" id="contact">
  <div class="wrap">
    <h2 class="sr-only" data-i18n="contact.heading">{t(locale, 'contact.heading')}</h2>

    <div class="contact__panels" data-reveal>
      {
        panels.map((panel) => (
          <article class="contact__panel">
            <Picture
              src={panel.src}
              formats={['avif', 'webp']}
              widths={[500, 800, 1200]}
              sizes="(min-width: 48rem) 45vw, 100vw"
              alt={t(locale, panel.altKey)}
              data-i18n-alt={panel.altKey}
              loading="lazy"
              decoding="async"
            />
            <h3 class="contact__panel-title" data-i18n={panel.titleKey}>
              {t(locale, panel.titleKey)}
            </h3>
          </article>
        ))
      }
    </div>

    <div class="contact__notes" data-reveal>
      <p data-i18n="contact.events">{t(locale, 'contact.events')}</p>
      <p data-i18n="contact.sourcing">{t(locale, 'contact.sourcing')}</p>
    </div>

    {/*
      The landline is rendered by the server and is what a visitor without
      JavaScript always gets — it is the primary number and the one in the
      JSON-LD, so the fallback is correct rather than merely safe.

      The number lives in its own <span> so the swap can replace the text
      without touching the icon beside it. Nothing here carries data-i18n: a
      phone number is not translated, so the language switcher never contends
      with the script for this element.
    */}
    <p class="contact__call" data-reveal>
      <span class="contact__call-label" data-i18n="contact.callUs">{t(locale, 'contact.callUs')}</span>
      <a
        class="contact__phone"
        id="contact-phone"
        href={`tel:${site.phone.href}`}
        data-hours={schedule}
        data-after-href={`tel:${site.phoneAfterHours.href}`}
        data-after-display={site.phoneAfterHours.display}
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          width="22"
          height="22"
          aria-hidden="true"
        >
          <path
            d="M6.5 3h3l1.5 4-2 1.5a12 12 0 0 0 5.5 5.5l1.5-2 4 1.5v3a2 2 0 0 1-2.2 2A17 17 0 0 1 4.5 5.2 2 2 0 0 1 6.5 3Z"
            stroke-linejoin="round"
          />
        </svg>
        <span class="contact__phone-number">{site.phone.display}</span>
      </a>
    </p>
  </div>
</section>

<script>
  // Outside opening hours the mobile answers instead of the landline.
  //
  // Evaluated in Europe/Athens, never in the visitor's own timezone: someone
  // calling from London at 22:00 is calling a restaurant where it is already
  // midnight, and the number they need is the one that rings after service.
  // Intl does the conversion, so no offset is hard-coded and DST is handled.
  //
  // The decision itself lives in lib/hours.ts so it can be tested directly;
  // this script only supplies the clock and swaps the two attributes.
  import { isOpenAt, type HoursEntry } from '../lib/hours';

  const link = document.getElementById('contact-phone');
  const numberEl = link?.querySelector('.contact__phone-number');

  if (link && numberEl) {
    const athensNow = () => {
      const parts = new Intl.DateTimeFormat('en-GB', {
        timeZone: 'Europe/Athens',
        weekday: 'long',
        hour: '2-digit',
        minute: '2-digit',
        hourCycle: 'h23',
      }).formatToParts(new Date());
      const get = (type: string) => parts.find((p) => p.type === type)?.value ?? '';
      return { day: get('weekday'), minutes: Number(get('hour')) * 60 + Number(get('minute')) };
    };

    try {
      const entries: HoursEntry[] = JSON.parse(link.dataset.hours || '[]');
      const { day, minutes } = athensNow();

      if (!isOpenAt(entries, day, minutes)) {
        const href = link.dataset.afterHref;
        const display = link.dataset.afterDisplay;
        if (href && display) {
          link.setAttribute('href', href);
          numberEl.textContent = display;
        }
      }
    } catch {
      // Any failure leaves the landline in place, which is the correct number
      // during service and a working number outside it.
    }
  }
</script>
