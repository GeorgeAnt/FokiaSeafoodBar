---
import { Image } from 'astro:assets';
import { t, defaultLocale, type Locale } from '../lib/i18n';
import { logoClean } from '../lib/photos';
import site from '../data/site.json';

interface Props {
  locale?: Locale;
}
const { locale = defaultLocale } = Astro.props;

const year = new Date().getFullYear();
---

{/*
  The mark and the copyright, and nothing else.

  The address, phone, email and social links that used to sit here are all
  already on the page above — Where to Find Us carries the address and hours,
  Take away & Reservations carries the phone, and the social icons live in the
  nav on every page. Repeating them in the footer added length, not information.

  Search is unaffected: the name/address/phone that matters for local results is
  in the Restaurant JSON-LD on the homepage, which is untouched, and still in the
  Find Us section.
*/}
<footer class="footer">
  <div class="wrap footer__inner">
    {/*
      Sized by height, not width. The file is 1672x940 with the badge centred in
      a wide transparent field, so constraining the width would shrink the mark
      itself to about half the box.
    */}
    <Image
      class="footer__logo"
      src={logoClean}
      alt={site.name}
      widths={[240, 480]}
      sizes="240px"
      loading="lazy"
      decoding="async"
    />

    <p class="footer__rights">
      © {year} {site.name}. <span data-i18n="footer.rights">{t(locale, 'footer.rights')}</span>
    </p>
  </div>
</footer>
