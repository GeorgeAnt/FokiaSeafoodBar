---
import { formatPrice, type MenuItem } from '../lib/menu';
import { t, defaultLocale, type Locale } from '../lib/i18n';

interface Props {
  item: MenuItem;
  locale?: Locale;
}
const { item, locale = defaultLocale } = Astro.props;

/* description / meta / variants / wine are each pre-joined per locale into one
   dictionary key in lib/i18n.ts's menuGroupKeys, so a lookup here is enough —
   see the note there for why. `t()` returns '' for a missing key's locale
   value only when the key itself is absent from the dictionary, which for an
   optional field means "this item has none": guard on the field, not on t(). */
const name = t(locale, `menu.item.${item.id}.name`);
const description = item.description ? t(locale, `menu.item.${item.id}.description`) : null;
const meta = item.unit || item.volume ? t(locale, `menu.item.${item.id}.meta`) : null;
const variants = item.variants?.length ? t(locale, `menu.item.${item.id}.variants`) : null;
const wineLine = item.wine ? t(locale, `menu.item.${item.id}.wineLine`) : null;
---

<li class="menu__item">
  <p class="menu__item-name" data-i18n={`menu.item.${item.id}.name`}>{name}</p>

  {
    item.price !== null ? (
      <p class="menu__item-price">{formatPrice(item.price)}</p>
    ) : (
      /* Not priced by the client yet. The item still appears — it is on the
         real menu — but shows an em dash rather than an empty cell. */
      <p class="menu__item-price menu__item-price--none">
        <span aria-hidden="true" data-i18n="menu.priceUnavailable">
          {t(locale, 'menu.priceUnavailable')}
        </span>
        <span class="sr-only" data-i18n="a11y.priceOnRequest">
          {t(locale, 'a11y.priceOnRequest')}
        </span>
      </p>
    )
  }

  {description && (
    <p class="menu__item-desc" data-i18n={`menu.item.${item.id}.description`}>
      {description}
    </p>
  )}

  {variants && (
    <p class="menu__item-variants" data-i18n={`menu.item.${item.id}.variants`}>
      {variants}
    </p>
  )}

  {wineLine && (
    <p class="menu__item-wine" data-i18n={`menu.item.${item.id}.wineLine`}>
      {wineLine}
    </p>
  )}

  {meta && (
    <p class="menu__item-meta" data-i18n={`menu.item.${item.id}.meta`}>
      {meta}
    </p>
  )}

  {
    item.tags?.length ? (
      <ul class="menu__tags">
        {item.tags.map((tag) => (
          <li class="menu__tag">{tag}</li>
        ))}
      </ul>
    ) : null
  }
</li>
