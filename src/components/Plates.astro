---
import { Picture } from 'astro:assets';
import { t, defaultLocale, type Locale } from '../lib/i18n';
import { galleryPhoto } from '../lib/photos';
import gallery from '../data/gallery.json';

interface Props {
  locale?: Locale;
}
const { locale = defaultLocale } = Astro.props;

/*
  The food, on the page that sells it.

  Before this band the homepage showed one cocktail and four staff portraits:
  every plate the kitchen actually sends out lived on /gallery, one click away
  from anyone who never got there. This is the product.

  Four ids rather than "the first four in gallery.json", because the gallery is
  ordered for the gallery — room, sign, drinks and plates interleaved — and this
  band wants plates only. Chosen by id so reordering gallery.json cannot quietly
  change what the homepage shows.
*/
const PLATE_IDS = ['sushi-board-overhead', 'ceviche-presented', 'seared-fish-puree', 'prawns-bisque'];

const plates = PLATE_IDS.map((id) => {
  const image = gallery.images.find((candidate) => candidate.id === id);
  if (!image) {
    throw new Error(
      `From the kitchen wants the gallery image "${id}", which has no entry in ` +
        `data/gallery.json. Add one (with alt text in both locales), or point ` +
        `PLATE_IDS in Plates.astro at an id that exists.`
    );
  }
  return { ...image, src: galleryPhoto(image.file), altKey: `gallery.${image.id}.alt` };
});
---

{/*
  .section-dark, which is --charcoal now rather than Deep Black, and so is every
  other band below the hero. The light / mid / dark alternation this comment
  used to describe is gone: bands are told apart by the 1px hairline
  .section-dark draws on top of itself. Black was the right ground for food
  photography and charcoal still is — this band lost the least in that change.

  Deliberately NOT in the nav, and the old reason given here (43px of clearance
  at 1025px) is three changes out of date — the bar collapses at 75rem now, not
  64rem. It is a content decision: the band is reached by scrolling and its own
  button goes to /gallery. See the nav note in CLAUDE.md for the current figure.
*/}
<section class="section section-dark plates" id="plates">
  <div class="wrap">
    {/*
      Centred, and deliberately NOT .section-head any more.

      That class sets --step-3 for the heading and --step-1 for the paragraph
      under it, and the client asked for this band to match Our Goal instead:
      --step-2 for the heading, plain body size for the line beneath. Rather
      than out-specifying .section-head from a later rule — same specificity,
      so it would have been winning on source order alone — the class is gone
      and .plates__head carries the whole thing. .section-head still styles
      /menu, /gallery, /team and Find Us, which are unchanged.

      The button used to live in here, on the right of a two-column header row.
      It is below the photographs now.
    */}
    <header class="plates__head" data-reveal>
      <h2 data-i18n="plates.heading">{t(locale, 'plates.heading')}</h2>
      <p data-i18n="plates.intro">{t(locale, 'plates.intro')}</p>
    </header>

    {/*
      Uneven columns and a stagger on the even ones. This is the page's one
      expressive layout — Team is a straight grid and Find Us is a split, so the
      variance is spent here rather than smeared across all three. The tracks are
      fractional rather than equal so the row does not read as four cards.

      On narrow screens it becomes a horizontal scroll-snap strip instead of a
      four-photo tower: the point of the band is that you take it in at a glance.
    */}
    <ul class="plates__row" data-reveal>
      {
        plates.map((plate) => (
          <li class="plates__item">
            {/*
              Each plate links to /gallery, which is where the rest of them are.

              The link takes its accessible name from the photo's own alt — the
              gallery's real per-image text — so four links to the same place
              are still told apart when read out, rather than four repetitions
              of "see the gallery". That is also why the alt stays non-empty
              here: emptying it would leave the link unnamed.

              The box styling moved to .plates__link with it. .plates__item kept
              overflow: hidden while it was the only element, and an ancestor
              with overflow: hidden clips a descendant's focus ring — see the
              note in global.css.
            */}
            <a class="plates__link" href="/gallery">
              <Picture
                src={plate.src}
                formats={['avif', 'webp']}
                widths={[300, 500, 700]}
                sizes="(min-width: 60rem) 24vw, 70vw"
                alt={t(locale, plate.altKey)}
                data-i18n-alt={plate.altKey}
                loading="lazy"
                decoding="async"
              />
            </a>
          </li>
        ))
      }
    </ul>

    {/* Below the photographs now, and centred under them. */}
    <p class="plates__actions" data-reveal>
      <a class="btn btn--primary plates__cta" href="/gallery" data-i18n="plates.cta">
        {t(locale, 'plates.cta')}
      </a>
    </p>
  </div>
</section>
