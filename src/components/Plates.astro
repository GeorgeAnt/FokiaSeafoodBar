---
import { Picture } from 'astro:assets';
import { t, defaultLocale, type Locale } from '../lib/i18n';
import { galleryPhoto } from '../lib/photos';
import gallery from '../data/gallery.json';

interface Props {
  locale?: Locale;
}
const { locale = defaultLocale } = Astro.props;

/*
  Four ids rather than "the first four in gallery.json": the gallery is ordered
  for the gallery — room, sign, drinks and plates interleaved — and this band
  wants plates only. By id, so reordering that file cannot change the homepage.
*/
const PLATE_IDS = ['sushi-board-overhead', 'ceviche-presented', 'seared-fish-puree', 'prawns-bisque'];

const plates = PLATE_IDS.map((id) => {
  const image = gallery.images.find((candidate) => candidate.id === id);
  if (!image) {
    throw new Error(
      `From the kitchen wants the gallery image "${id}", which has no entry in ` +
        `data/gallery.json. Add one (with alt text in both locales), or point ` +
        `PLATE_IDS in Plates.astro at an id that exists.`
    );
  }
  return { ...image, src: galleryPhoto(image.file), altKey: `gallery.${image.id}.alt` };
});
---

{/*
  Deliberately NOT in the nav: the band is reached by scrolling and its own
  button goes to /gallery. Adding a link costs the bar nothing either way — the
  nav has shown no inline link list at any width since the burger became the
  only way in.
*/}
<section class="section section-dark plates" id="plates">
  <div class="wrap">
    {/*
      Centred, and deliberately NOT .section-head: that class sets --step-3 and
      --step-1, and the client asked this band to match Our Goal (--step-2 over
      body size). Equal specificity, so keeping it would have meant winning on
      source order alone.
    */}
    <header class="plates__head" data-reveal>
      <h2 data-i18n="plates.heading">{t(locale, 'plates.heading')}</h2>
      <p data-i18n="plates.intro">{t(locale, 'plates.intro')}</p>
    </header>

    {/*
      Uneven columns and a stagger on the even ones — the page's one expressive
      layout, so the variance is spent here rather than smeared across bands.
      2x2 on a phone; see .plates__row in global.css for why not a scroll strip.
    */}
    <ul class="plates__row" data-reveal>
      {
        plates.map((plate) => (
          <li class="plates__item">
            {/*
              Each plate links to /gallery, and takes its accessible name from
              the photo's own alt, so four links to the same place are still
              told apart when read out — which is why the alt stays non-empty
              here. The box styling lives on .plates__link, not .plates__item:
              an ancestor with overflow: hidden clips a descendant's focus ring.
            */}
            <a class="plates__link" href="/gallery">
              <Picture
                src={plate.src}
                formats={['avif', 'webp']}
                widths={[300, 500, 700]}
                sizes="(min-width: 60rem) 24vw, 70vw"
                alt={t(locale, plate.altKey)}
                data-i18n-alt={plate.altKey}
                loading="lazy"
                decoding="async"
              />
            </a>
          </li>
        ))
      }
    </ul>

    {/* Below the photographs now, and centred under them. */}
    <p class="plates__actions" data-reveal>
      <a class="btn btn--primary plates__cta" href="/gallery" data-i18n="plates.cta">
        {t(locale, 'plates.cta')}
      </a>
    </p>
  </div>
</section>
