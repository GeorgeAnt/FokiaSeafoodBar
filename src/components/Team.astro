---
import { Picture } from 'astro:assets';
import { t, defaultLocale, type Locale } from '../lib/i18n';
import { teamPhoto } from '../lib/photos';
import team from '../data/team.json';

interface Props {
  locale?: Locale;
}
const { locale = defaultLocale } = Astro.props;
---

<section class="section" id="team">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <h2 data-i18n="team.heading">{t(locale, 'team.heading')}</h2>
      <p data-i18n="team.intro">{t(locale, 'team.intro')}</p>
    </header>

    <!--
      One portrait plus a paragraph each, as alternating rows: photo left on odd
      members, photo right on even ones. The photo column is a fixed 4:5 so row
      heights stay even from four members to six, and every portrait gets the
      same crop.

      This is the layout the section had before the portrait grid, restored at
      the client's request because five columns put the bios in ~220px tracks —
      about four words a line. The cost is the one the grid was built to avoid:
      the page runs this composition once per member, and Find Us below is
      another of the same shape. Revisit if the section grows again.
    -->
    <div class="team__list" data-reveal>
      {
        team.members.map((member) => (
          <article class="team__member">
            <div class="team__photo">
              <Picture
                src={teamPhoto(member.photo)}
                formats={['avif', 'webp']}
                widths={[400, 600, 800]}
                sizes="(min-width: 48rem) 40vw, 100vw"
                alt={member.name}
                loading="lazy"
                decoding="async"
              />
            </div>

            <div class="team__text">
              {/* Names are never translated. */}
              <h3 class="team__name">{member.name}</h3>
              <p class="team__role" data-i18n={`team.${member.id}.role`}>
                {t(locale, `team.${member.id}.role`)}
              </p>
              <p class="team__bio" data-i18n={`team.${member.id}.bio`}>
                {t(locale, `team.${member.id}.bio`)}
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
