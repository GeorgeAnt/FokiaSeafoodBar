---
import { Picture, getImage } from 'astro:assets';
import { t, defaultLocale, type Locale } from '../lib/i18n';
import { teamPhoto } from '../lib/photos';
import team from '../data/team.json';
import greyConcrete from '../assets/photos/backgrounds/grunge-gray-cement-textured-background.jpg';

interface Props {
  locale?: Locale;
}
const { locale = defaultLocale } = Astro.props;

// TEMP: visual test of the grey concrete texture as the section background.
// The overlay and the token changes live on .section--concrete-test in
// global.css; this only hands it the optimised texture, because the source jpg
// is 9.3MB and has to go through the image pipeline rather than a CSS url().
//
// 2560 rather than the source's native 4666: this is a full-bleed cover
// background, so it has to outrun the widest ordinary desktop viewport rather
// than match a fixed box. 1920 was visibly soft stretched across a wider
// screen; 2560 (654KB webp) covers that without paying for the full 4666
// (1.7MB+) a background texture does not need.
const bgTest = await getImage({ src: greyConcrete, format: 'webp', width: 2560 });
---

{/*
  This renders on /team and nowhere else, which is why the heading is an <h1>:
  it is that page's only one. It was an <h2> while the section sat on the
  homepage under the hero logo's h1. See src/pages/team.astro for why it moved.
*/}
<section
  class="section section--concrete-test"
  id="team"
  style={`--bg-texture: url(${bgTest.src})`}
>
  <div class="wrap">
    <header class="section-head" data-reveal>
      <h1 data-i18n="team.heading">{t(locale, 'team.heading')}</h1>
      <p data-i18n="team.intro">{t(locale, 'team.intro')}</p>
    </header>

    <!--
      One portrait plus a paragraph each, as alternating rows: photo left on odd
      members, photo right on even ones. The photo column is a fixed 4:5 so row
      heights stay even from four members to six, and every portrait gets the
      same crop.

      This is the layout the section had before the portrait grid, restored at
      the client's request because five columns put the bios in ~220px tracks —
      about four words a line. The cost is the one the grid was built to avoid:
      the page runs this composition once per member, and Find Us below is
      another of the same shape. Revisit if the section grows again.
    -->
    <div class="team__list" data-reveal>
      {
        team.members.map((member) => (
          <article class="team__member">
            <div class="team__photo">
              <Picture
                src={teamPhoto(member.photo)}
                formats={['avif', 'webp']}
                widths={[400, 600, 800]}
                sizes="(min-width: 48rem) 40vw, 100vw"
                alt={t(locale, `team.${member.id}.name`)}
                data-i18n-alt={`team.${member.id}.name`}
                loading="lazy"
                decoding="async"
              />
            </div>

            <div class="team__text">
              {/* Locale-keyed like the role and bio — see team.json. The alt
                  on the portrait above carries the same key, so the language
                  switch reaches both. */}
              {/* h2, not h3: the section heading above is now this page's h1,
                  and h1 -> h3 skips a level. .team__name is a class selector so
                  the tag change moves nothing visually. */}
              <h2 class="team__name" data-i18n={`team.${member.id}.name`}>
                {t(locale, `team.${member.id}.name`)}
              </h2>
              <p class="team__role" data-i18n={`team.${member.id}.role`}>
                {t(locale, `team.${member.id}.role`)}
              </p>
              <p class="team__bio" data-i18n={`team.${member.id}.bio`}>
                {t(locale, `team.${member.id}.bio`)}
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
