---
import { Picture, getImage } from 'astro:assets';
import { t, defaultLocale, type Locale } from '../lib/i18n';
import { teamPhoto } from '../lib/photos';
import team from '../data/team.json';
import greyConcrete from '../assets/photos/backgrounds/grunge-gray-cement-textured-background.jpg';

interface Props {
  locale?: Locale;
}
const { locale = defaultLocale } = Astro.props;

// TEMP: same concrete ground as /menu and /gallery — see
// .section--concrete-test in global.css, which owns the overlay, the token
// changes and why 2560 is enough (background-attachment: fixed ties cover's
// math to the viewport rather than to this list's own scrolling height). This
// only hands it the optimised texture; the source jpg is 9.3MB.
const bgTest = await getImage({ src: greyConcrete, format: 'webp', width: 2560 });
---

{/*
  This renders on /team and nowhere else, which is why the heading is an <h1>.
*/}
<section
  class="section section--concrete-test"
  id="team"
  style={`--bg-texture: url(${bgTest.src})`}
>
  <div class="wrap">
    <header class="section-head" data-reveal>
      <h1 data-i18n="team.heading">{t(locale, 'team.heading')}</h1>
      <p data-i18n="team.intro">{t(locale, 'team.intro')}</p>
    </header>

    <!--
      Alternating rows: photo left on odd members, right on even. The photo
      column is a fixed 4:5 so row heights stay even from four members to six.
      A portrait grid was tried and reverted — five columns put the bios in
      ~220px tracks, about four words a line. The cost is page height.
    -->
    <div class="team__list" data-reveal>
      {
        team.members.map((member, index) => (
          <article class="team__member">
            <div class="team__photo">
              {/* The first row is in the initial viewport at every width, so it
                  is this page's LCP image; everything below stays lazy.

                  Recorded because it is a plausible wrong answer: this was
                  changed while chasing "the first team photo doesn't appear
                  until I scroll" and did NOT fix it. The cause was the reveal
                  observer's threshold in Base.astro — the photo had loaded
                  (img.complete === true) and was sitting under opacity: 0. */}
              <Picture
                src={teamPhoto(member.photo)}
                formats={['avif', 'webp']}
                widths={[400, 600, 800]}
                sizes="(min-width: 48rem) 40vw, 100vw"
                alt={t(locale, `team.${member.id}.name`)}
                data-i18n-alt={`team.${member.id}.name`}
                loading={index === 0 ? 'eager' : 'lazy'}
                decoding="async"
                fetchpriority={index === 0 ? 'high' : 'auto'}
              />
            </div>

            <div class="team__text">
              {/* Locale-keyed like the role and bio — see team.json. The alt
                  on the portrait above carries the same key, so the language
                  switch reaches both. */}
              {/* h2, not h3: the section heading above is now this page's h1,
                  and h1 -> h3 skips a level. .team__name is a class selector so
                  the tag change moves nothing visually. */}
              <h2 class="team__name" data-i18n={`team.${member.id}.name`}>
                {t(locale, `team.${member.id}.name`)}
              </h2>
              <p class="team__role" data-i18n={`team.${member.id}.role`}>
                {t(locale, `team.${member.id}.role`)}
              </p>
              <p class="team__bio" data-i18n={`team.${member.id}.bio`}>
                {t(locale, `team.${member.id}.bio`)}
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
