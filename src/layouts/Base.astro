---
import '../styles/global.css';
import { dictionaries, defaultLocale, t, type Locale } from '../lib/i18n';
import { foodCategories, drinkCategories } from '../lib/menu';
import site from '../data/site.json';

interface Props {
  locale?: Locale;
  /** i18n keys for this page's title and description. */
  titleKey?: string;
  descriptionKey?: string;
  /**
   * Emits the Menu / MenuSection / MenuItem graph. Only the menu page sets this
   * — the graph is ~14 KB, and it belongs on the page that actually shows it.
   */
  menuSchema?: boolean;
}
const {
  locale = defaultLocale,
  titleKey = 'meta.title',
  descriptionKey = 'meta.description',
  menuSchema = false,
} = Astro.props;

const origin = Astro.site ?? new URL('https://example.com');
const canonical = new URL(Astro.url.pathname, origin).toString();
const menuUrl = new URL('/menu', origin).toString();

const title = t(locale, titleKey);
const description = t(locale, descriptionKey);

/* ---------------------------------------------------------------------------
   Structured data.

   The menu is Greek-only, so Menu/MenuSection/MenuItem carry Greek values in
   both locales — inventing English dish names purely for search engines would
   describe food the restaurant does not serve under those names.
   --------------------------------------------------------------------------- */
const menuSections = [...foodCategories, ...drinkCategories].flatMap((category) => {
  const groups = category.subcategories?.length
    ? category.subcategories.map((sub) => ({
        name: `${category.name} — ${sub.name}`,
        items: sub.items ?? [],
      }))
    : [{ name: category.name, items: category.items ?? [] }];

  return groups.map((group) => ({
    '@type': 'MenuSection',
    name: group.name,
    hasMenuItem: group.items.map((item) => ({
      '@type': 'MenuItem',
      name: item.name,
      ...(item.description ? { description: item.description } : {}),
      ...(item.price !== null
        ? {
            offers: {
              '@type': 'Offer',
              price: item.price,
              priceCurrency: 'EUR',
            },
          }
        : {}),
    })),
  }));
});

const openingHours = site.hours.entries.map((entry) => ({
  '@type': 'OpeningHoursSpecification',
  dayOfWeek: entry.days,
  opens: entry.opens,
  closes: entry.closes,
}));

const restaurantSchema = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: site.name,
  description: t(locale, 'meta.description'),
  url: canonical,
  telephone: site.phone.href,
  email: site.email,
  servesCuisine: site.seo.servesCuisine,
  priceRange: site.seo.priceRange,
  acceptsReservations: site.seo.acceptsReservations,
  // Links the site to the restaurant's official profiles, so search engines
  // treat them as the same entity.
  sameAs: site.social.filter((link) => link.url).map((link) => link.url),
  hasMap: site.mapUrl || undefined,
  address: {
    '@type': 'PostalAddress',
    // Structured data carries one form of the address; the Greek one, since
    // that is the address as it is written locally.
    streetAddress: site.address.street.el,
    addressLocality: site.address.city.el,
    addressRegion: site.address.region.el,
    postalCode: site.address.postalCode,
    addressCountry: site.address.country,
  },
  // Omitted entirely while unknown — emitting null coordinates would be worse
  // than emitting nothing.
  ...(site.geo.latitude !== null && site.geo.longitude !== null
    ? {
        geo: {
          '@type': 'GeoCoordinates',
          latitude: site.geo.latitude,
          longitude: site.geo.longitude,
        },
      }
    : {}),
  openingHoursSpecification: openingHours,
  // A URL rather than an inline graph: schema.org expects hasMenu to point at
  // the menu, and it keeps 14 KB of structured data off every other page.
  hasMenu: menuUrl,
};

/** Emitted only on /menu, where the items actually are. */
const menuGraph = {
  '@context': 'https://schema.org',
  '@type': 'Menu',
  '@id': menuUrl,
  name: t(locale, 'menu.heading'),
  url: menuUrl,
  inLanguage: 'el',
  hasMenuSection: menuSections,
};

const schemas = menuSchema ? [restaurantSchema, menuGraph] : [restaurantSchema];

/* Both dictionaries ship inline. Together they are a few kilobytes — smaller
   than the round trip a fetch would cost, and it means switching language never
   waits on the network. */
const dictJson = JSON.stringify(dictionaries);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Generated from the client's logo by `npm run favicons`. */}
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    {/*
      The faces that paint above the fold are preloaded. This is a deliberate
      departure from "preload only the hero image": measurement showed the
      page's entire layout-shift score came from `font-display: swap` reflowing
      text as each face arrived, and preloading removed the shift entirely.

      Not all ten files — the split to static builds turned four files into ten,
      and preloading the lot would push ~160 KB ahead of the LCP image for glyphs
      that may never render. These six are the ones a Greek page paints
      immediately: body text, labels and buttons in Inter, headings in Garamond,
      both scripts. Inter 500 and the italic load normally — 500 sits lower in
      the page and the italic only appears on /menu.
    */}
    <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-latin-400-normal.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-greek-400-normal.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-latin-600-normal.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-greek-600-normal.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/eb-garamond-latin-600-normal.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/eb-garamond-greek-600-normal.woff2" crossorigin />

    <title data-i18n={titleKey}>{title}</title>
    <meta name="description" content={description} data-i18n-content={descriptionKey} />

    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="el" href={canonical} />
    <link rel="alternate" hreflang="en" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />

    <meta property="og:type" content="restaurant.restaurant" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} data-i18n-content={titleKey} />
    <meta property="og:description" content={description} data-i18n-content={descriptionKey} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="el_GR" />
    <meta property="og:locale:alternate" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />

    {/*
      Matches `body`'s background (--salt), not the hero. theme-color paints the
      browser's own chrome and the overscroll gutter, which sit against the page
      background — pointing it at the black hero band left a dark bar above a
      light page on every route except the top of the homepage.
    */}
    <meta name="theme-color" content="#e2e8eb" />

    {schemas.map((schema) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <script is:inline>
      /**
       * Reveal-on-scroll for anything carrying `data-reveal`.
       *
       * Inline and in the head on purpose, and it is one script rather than two.
       * The CSS that hides a pending block keys off `.has-reveal`, so whatever
       * adds that class MUST also be able to take the block out of hiding again
       * — a deferred module that failed to load would leave half the homepage
       * invisible. An inline script cannot fail to arrive, and it sets the class
       * before first paint, so nothing flashes in and then hides.
       *
       * Both guards run before the class is added: with reduced motion, or
       * without IntersectionObserver, the page stays plain rather than hidden.
       */
      (function () {
        if (!window.matchMedia('(prefers-reduced-motion: no-preference)').matches) return;
        if (!('IntersectionObserver' in window)) return;

        document.documentElement.classList.add('has-reveal');

        // The body is not parsed yet, so the targets are collected on
        // DOMContentLoaded — same script, so there is still nothing to fail.
        document.addEventListener('DOMContentLoaded', function () {
          var observer = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (!entry.isIntersecting) return;
                entry.target.setAttribute('data-revealed', '');
                // Once only: a band does not re-animate when scrolled back to.
                observer.unobserve(entry.target);
              });
            },
            // Held back from the very bottom edge so a band starts moving once
            // it is properly in view rather than as its first pixel appears.
            { rootMargin: '0px 0px -10% 0px', threshold: 0.08 }
          );

          document.querySelectorAll('[data-reveal]').forEach(function (el) {
            observer.observe(el);
          });
        });
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main" data-i18n="a11y.skipToContent">{t(locale, 'a11y.skipToContent')}</a>
    <slot />

    <script is:inline type="application/json" id="i18n-dict" set:html={dictJson} />

    <script is:inline>
      /**
       * Language switcher.
       *
       * Greek is server-rendered, so the page is already correct before this
       * runs; this only swaps chrome when the visitor has chosen English. The
       * menu section is marked lang="el" in the markup and is never touched —
       * its content is Greek in both locales.
       */
      (function () {
        var KEY = 'fokia:lang';
        var DEFAULT = 'el';
        var node = document.getElementById('i18n-dict');
        if (!node) return;
        var dict = JSON.parse(node.textContent || '{}');
        var current = DEFAULT;

        /* Applies one element's label key in whatever locale is current. Shared
           by apply() and by setLabelKey() below so a two-state control and the
           language switch always resolve a label the same way. */
        function label(el, value) {
          // Labels that count something (the carousel dots) carry their number
          // separately, so the translated string keeps its {n} placeholder.
          var n = el.getAttribute('data-i18n-n');
          el.setAttribute('aria-label', n != null ? value.replace('{n}', n) : value);
        }

        function apply(lang) {
          var strings = dict[lang];
          if (!strings) return;
          current = lang;

          document.documentElement.lang = lang;

          document.querySelectorAll('[data-i18n]').forEach(function (el) {
            var value = strings[el.getAttribute('data-i18n')];
            if (value != null) el.textContent = value;
          });

          document.querySelectorAll('[data-i18n-content]').forEach(function (el) {
            var value = strings[el.getAttribute('data-i18n-content')];
            if (value != null) el.setAttribute('content', value);
          });

          document.querySelectorAll('[data-i18n-alt]').forEach(function (el) {
            var value = strings[el.getAttribute('data-i18n-alt')];
            if (value != null) el.setAttribute('alt', value);
          });

          document.querySelectorAll('[data-i18n-label]').forEach(function (el) {
            var value = strings[el.getAttribute('data-i18n-label')];
            if (value != null) label(el, value);
          });

          document.querySelectorAll('[data-lang-btn]').forEach(function (btn) {
            btn.setAttribute('aria-pressed', String(btn.getAttribute('data-lang-btn') === lang));
          });
        }

        function persist(lang) {
          try {
            localStorage.setItem(KEY, lang);
          } catch (e) {
            /* private mode — the choice simply does not persist */
          }
        }

        var stored;
        try {
          stored = localStorage.getItem(KEY);
        } catch (e) {
          stored = null;
        }
        if (stored && stored !== DEFAULT) apply(stored);

        document.querySelectorAll('[data-lang-btn]').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var lang = btn.getAttribute('data-lang-btn');
            apply(lang);
            persist(lang);
          });
        });

        /*
          The small surface the section scripts need.

          Both of them build controls by cloning a <template>, and template
          content is a separate document fragment — `document.querySelectorAll`
          never sees inside it, so the pass above has already run and skipped
          those nodes by the time they are cloned. Without `refresh()` a visitor
          on English got Greek labels on the hero dots and every lightbox
          control, because the clone carries whatever Astro server-rendered.

          `setLabelKey` is for a control whose label changes with its state (the
          nav toggle, the hero pause button). The script picks the *key*; the
          string still comes from the dictionary, so the language switch keeps
          working on it afterwards.
        */
        window.fokiaI18n = {
          refresh: function () {
            apply(current);
          },
          setLabelKey: function (el, key) {
            el.setAttribute('data-i18n-label', key);
            var value = (dict[current] || {})[key];
            if (value != null) label(el, value);
          },
        };
      })();
    </script>
  </body>
</html>
