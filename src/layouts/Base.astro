---
import '../styles/global.css';
import { dictionaries, defaultLocale, t, type Locale } from '../lib/i18n';
import { foodCategories, drinkCategories } from '../lib/menu';
import site from '../data/site.json';
import { indexable } from '../lib/indexable';

interface Props {
  locale?: Locale;
  /** i18n keys for this page's title and description. */
  titleKey?: string;
  descriptionKey?: string;
  /**
   * Emits the Menu / MenuSection / MenuItem graph. Only the menu page sets this
   * — the graph is ~14 KB, and it belongs on the page that actually shows it.
   */
  menuSchema?: boolean;
}
const {
  locale = defaultLocale,
  titleKey = 'meta.title',
  descriptionKey = 'meta.description',
  menuSchema = false,
} = Astro.props;

/*
  Astro.site is site.seo.url (see astro.config.mjs), so this fallback is
  unreachable and exists only to keep the type URL rather than URL | undefined.
  It names the production domain deliberately: the example.com placeholder that
  used to sit here shipped canonicals pointing at someone else's domain for
  months, because a static build never throws on a well-formed URL.
*/
const origin = Astro.site ?? new URL(site.seo.url);
const canonical = new URL(Astro.url.pathname, origin).toString();
const menuUrl = new URL('/menu', origin).toString();

/*
  The share card. Absolute, because a crawler has no page context to resolve a
  relative path against and Facebook/LinkedIn drop one silently. A static file
  in public/, not a <Picture /> variant: those are content-hashed and
  format-negotiated and a crawler runs none of that. Regenerated by npm run og.
  One card for the whole site and both locales.
*/
const ogImage = new URL(site.seo.ogImage, origin).toString();

const title = t(locale, titleKey);
const description = t(locale, descriptionKey);

/* Structured data. Menu text is locale-keyed (see lib/i18n.ts), so this pulls
   the value for the locale that rendered. /menu always server-renders Greek, so
   inLanguage below is pinned to 'el'; locale-routed pages would change that. */
const menuSections = [...foodCategories, ...drinkCategories].flatMap((category) => {
  const groups = category.subcategories?.length
    ? category.subcategories.map((sub) => ({
        name: `${category.name[locale]} — ${sub.name[locale]}`,
        items: sub.items ?? [],
      }))
    : [{ name: category.name[locale], items: category.items ?? [] }];

  return groups.map((group) => ({
    '@type': 'MenuSection',
    name: group.name,
    hasMenuItem: group.items.map((item) => ({
      '@type': 'MenuItem',
      name: item.name[locale],
      ...(item.description ? { description: item.description[locale] } : {}),
      ...(item.price !== null
        ? {
            offers: {
              '@type': 'Offer',
              price: item.price,
              priceCurrency: 'EUR',
            },
          }
        : {}),
    })),
  }));
});

const openingHours = site.hours.entries.map((entry) => ({
  '@type': 'OpeningHoursSpecification',
  dayOfWeek: entry.days,
  opens: entry.opens,
  closes: entry.closes,
}));

const restaurantSchema = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: site.name,
  description: t(locale, 'meta.description'),
  url: canonical,
  telephone: site.phone.href,
  email: site.email,
  servesCuisine: site.seo.servesCuisine,
  priceRange: site.seo.priceRange,
  acceptsReservations: site.seo.acceptsReservations,
  // Links the site to the restaurant's official profiles, so search engines
  // treat them as the same entity.
  sameAs: site.social.filter((link) => link.url).map((link) => link.url),
  hasMap: site.mapUrl || undefined,
  address: {
    '@type': 'PostalAddress',
    // Structured data carries one form of the address; the Greek one, since
    // that is the address as it is written locally.
    streetAddress: site.address.street.el,
    addressLocality: site.address.city.el,
    addressRegion: site.address.region.el,
    postalCode: site.address.postalCode,
    addressCountry: site.address.country,
  },
  // Omitted entirely while unknown — emitting null coordinates would be worse
  // than emitting nothing.
  ...(site.geo.latitude !== null && site.geo.longitude !== null
    ? {
        geo: {
          '@type': 'GeoCoordinates',
          latitude: site.geo.latitude,
          longitude: site.geo.longitude,
        },
      }
    : {}),
  openingHoursSpecification: openingHours,
  // A URL rather than an inline graph: schema.org expects hasMenu to point at
  // the menu, and it keeps 14 KB of structured data off every other page.
  hasMenu: menuUrl,
};

/** Emitted only on /menu, where the items actually are. */
const menuGraph = {
  '@context': 'https://schema.org',
  '@type': 'Menu',
  '@id': menuUrl,
  name: t(locale, 'menu.heading'),
  url: menuUrl,
  inLanguage: 'el',
  hasMenuSection: menuSections,
};

const schemas = menuSchema ? [restaurantSchema, menuGraph] : [restaurantSchema];

/* Both dictionaries ship inline. Together they are a few kilobytes — smaller
   than the round trip a fetch would cost, and it means switching language never
   waits on the network. */
const dictJson = JSON.stringify(dictionaries);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Generated from the client's logo by `npm run favicons`. */}
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    {/*
      The faces that paint above the fold are preloaded: the page's whole
      layout-shift score came from font-display: swap reflowing text as each
      face arrived. Not all eight — that would push bytes ahead of the LCP image
      for glyphs that may never render. Manrope 500 is never above the fold.
    */}
    <link rel="preload" as="font" type="font/woff2" href="/fonts/manrope-latin-400-normal.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/manrope-greek-400-normal.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/manrope-latin-600-normal.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/manrope-greek-600-normal.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/manrope-latin-700-normal.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/manrope-greek-700-normal.woff2" crossorigin />

    <title data-i18n={titleKey}>{title}</title>
    <meta name="description" content={description} data-i18n-content={descriptionKey} />

    {/*
      Preview deployments are excluded from search, production is not. This is
      one half of it and robots.txt is the other; neither covers the other's
      case (a disallowed URL can still be listed without a snippet).
    */}
    {!indexable && <meta name="robots" content="noindex, nofollow" />}

    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="el" href={canonical} />
    <link rel="alternate" hreflang="en" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />

    <meta property="og:type" content="restaurant.restaurant" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} data-i18n-content={titleKey} />
    <meta property="og:description" content={description} data-i18n-content={descriptionKey} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="el_GR" />
    <meta property="og:locale:alternate" content="en_GB" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {/* The card is the logo over a photograph, so the mark is what the alt names. */}
    <meta property="og:image:alt" content={`${site.name} ${site.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    {/*
      Matches the nav (--black), which is what the browser chrome actually butts
      against — the rule is "match what the chrome butts against", not "match
      body". Both ends of the document are black, so the overscroll gutter
      agrees at both. If the bar ever goes light again, this goes with it.
    */}
    <meta name="theme-color" content="#181414" />

    {schemas.map((schema) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <script is:inline>
      /**
       * Reveal-on-scroll for anything carrying data-reveal.
       *
       * Inline, in the head, and one script: the CSS that hides a pending block
       * keys off .has-reveal, so whatever adds that class MUST also be able to
       * un-hide it — a deferred module that failed to load would leave half the
       * homepage invisible. Inline also lands the class before first paint.
       *
       * Both guards run before the class is added.
       */
      (function () {
        if (!window.matchMedia('(prefers-reduced-motion: no-preference)').matches) return;
        if (!('IntersectionObserver' in window)) return;

        document.documentElement.classList.add('has-reveal');

        // The body is not parsed yet, so the targets are collected on
        // DOMContentLoaded — same script, so there is still nothing to fail.
        document.addEventListener('DOMContentLoaded', function () {
          var observer = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (!entry.isIntersecting) return;
                entry.target.setAttribute('data-revealed', '');
                // Once only: a band does not re-animate when scrolled back to.
                observer.unobserve(entry.target);
              });
            },
            /*
              rootMargin holds a band back until it is properly in view.

              threshold MUST stay 0: a threshold is a fraction of the TARGET's
              own area, not of the viewport, so a target taller than the screen
              may never reach it. At 0.08, /team's ~2863px list could only ever
              show 5.2% at a 600px viewport and loaded at opacity 0 until the
              visitor scrolled — while clearing 8% at 768px by 0.07 of a point,
              which is why it tested fine. Keep the trigger height-independent.
            */
            { rootMargin: '0px 0px -10% 0px', threshold: 0 }
          );

          document.querySelectorAll('[data-reveal]').forEach(function (el) {
            observer.observe(el);
          });
        });
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main" data-i18n="a11y.skipToContent">{t(locale, 'a11y.skipToContent')}</a>
    <slot />

    <script is:inline type="application/json" id="i18n-dict" set:html={dictJson} />

    <script is:inline>
      /**
       * Language switcher. Greek is server-rendered, so this only swaps chrome
       * when the visitor has chosen English.
       */
      (function () {
        var KEY = 'fokia:lang';
        var DEFAULT = 'el';
        var node = document.getElementById('i18n-dict');
        if (!node) return;
        var dict = JSON.parse(node.textContent || '{}');
        var current = DEFAULT;

        /* Applies one element's label key in whatever locale is current. Shared
           by apply() and by setLabelKey() below so a two-state control and the
           language switch always resolve a label the same way. */
        function label(el, value) {
          // Labels that count something (the carousel dots) carry their number
          // separately, so the translated string keeps its {n} placeholder.
          var n = el.getAttribute('data-i18n-n');
          el.setAttribute('aria-label', n != null ? value.replace('{n}', n) : value);
        }

        function apply(lang) {
          var strings = dict[lang];
          if (!strings) return;
          current = lang;

          document.documentElement.lang = lang;

          /* Re-aim the language button at the OTHER locale before the passes
             below run, so its text and label come from the same dictionary
             lookups as everything else. Point first, translate second. */
          var toggle = document.querySelector('[data-lang-target]');
          if (toggle) {
            var other = lang === 'el' ? 'en' : 'el';
            toggle.setAttribute('data-lang-target', other);
            toggle.setAttribute('lang', other);
            toggle.setAttribute('data-i18n-label', 'a11y.lang.' + other);
            /* Both labels are re-aimed, not just the visible one: which of the
               two is shown is a CSS decision this script cannot see, and the
               hidden one becomes visible on a resize with no script involved. */
            var name = toggle.querySelector('[data-lang-name]');
            var code = toggle.querySelector('[data-lang-code]');
            if (name) name.setAttribute('data-i18n', 'lang.' + other);
            if (code) code.setAttribute('data-i18n', 'lang.short.' + other);
          }

          document.querySelectorAll('[data-i18n]').forEach(function (el) {
            var value = strings[el.getAttribute('data-i18n')];
            if (value != null) el.textContent = value;
          });

          document.querySelectorAll('[data-i18n-content]').forEach(function (el) {
            var value = strings[el.getAttribute('data-i18n-content')];
            if (value != null) el.setAttribute('content', value);
          });

          document.querySelectorAll('[data-i18n-alt]').forEach(function (el) {
            var value = strings[el.getAttribute('data-i18n-alt')];
            if (value != null) el.setAttribute('alt', value);
          });

          document.querySelectorAll('[data-i18n-label]').forEach(function (el) {
            var value = strings[el.getAttribute('data-i18n-label')];
            if (value != null) label(el, value);
          });
        }

        function persist(lang) {
          try {
            localStorage.setItem(KEY, lang);
          } catch (e) {
            /* private mode — the choice simply does not persist */
          }
        }

        var stored;
        try {
          stored = localStorage.getItem(KEY);
        } catch (e) {
          stored = null;
        }
        if (stored && stored !== DEFAULT) apply(stored);

        /* Read at click time, not captured: apply() flips the attribute, so the
           same button switches back on the next press. */
        var langToggle = document.querySelector('[data-lang-target]');
        if (langToggle) {
          langToggle.addEventListener('click', function () {
            var next = langToggle.getAttribute('data-lang-target');
            apply(next);
            persist(next);
          });
        }

        /*
          The surface the section scripts need.

          Both clone a <template>, and template content is a separate document
          fragment that document.querySelectorAll never sees inside — so without
          refresh() a visitor on English got Greek labels on the hero dots and
          every lightbox control.

          setLabelKey is for a control whose label changes with its STATE. Both
          take a key, never a string: dict is private to this closure, and a
          caller writing the words itself would hard-code both locales and go
          stale the moment the copy moved.

          A setTextKey (the same idea for visible text) has been added and
          removed twice, each time with its only caller. If it is needed a third
          time, write it again — still taking a key.
        */
        window.fokiaI18n = {
          refresh: function () {
            apply(current);
          },
          setLabelKey: function (el, key) {
            el.setAttribute('data-i18n-label', key);
            var value = (dict[current] || {})[key];
            if (value != null) label(el, value);
          },
        };
      })();
    </script>
  </body>
</html>
