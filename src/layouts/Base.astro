---
import '../styles/global.css';
import { dictionaries, defaultLocale, t, type Locale } from '../lib/i18n';
import { foodCategories, drinkCategories } from '../lib/menu';
import site from '../data/site.json';

interface Props {
  locale?: Locale;
  /** i18n keys for this page's title and description. */
  titleKey?: string;
  descriptionKey?: string;
  /**
   * Emits the Menu / MenuSection / MenuItem graph. Only the menu page sets this
   * — the graph is ~14 KB, and it belongs on the page that actually shows it.
   */
  menuSchema?: boolean;
}
const {
  locale = defaultLocale,
  titleKey = 'meta.title',
  descriptionKey = 'meta.description',
  menuSchema = false,
} = Astro.props;

const origin = Astro.site ?? new URL('https://example.com');
const canonical = new URL(Astro.url.pathname, origin).toString();
const menuUrl = new URL('/menu', origin).toString();

const title = t(locale, titleKey);
const description = t(locale, descriptionKey);

/* ---------------------------------------------------------------------------
   Structured data.

   The menu is Greek-only, so Menu/MenuSection/MenuItem carry Greek values in
   both locales — inventing English dish names purely for search engines would
   describe food the restaurant does not serve under those names.
   --------------------------------------------------------------------------- */
const menuSections = [...foodCategories, ...drinkCategories].flatMap((category) => {
  const groups = category.subcategories?.length
    ? category.subcategories.map((sub) => ({
        name: `${category.name} — ${sub.name}`,
        items: sub.items ?? [],
      }))
    : [{ name: category.name, items: category.items ?? [] }];

  return groups.map((group) => ({
    '@type': 'MenuSection',
    name: group.name,
    hasMenuItem: group.items.map((item) => ({
      '@type': 'MenuItem',
      name: item.name,
      ...(item.description ? { description: item.description } : {}),
      ...(item.price !== null
        ? {
            offers: {
              '@type': 'Offer',
              price: item.price,
              priceCurrency: 'EUR',
            },
          }
        : {}),
    })),
  }));
});

const openingHours = site.hours.entries.map((entry) => ({
  '@type': 'OpeningHoursSpecification',
  dayOfWeek: entry.days,
  opens: entry.opens,
  closes: entry.closes,
}));

const restaurantSchema = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: site.name,
  description: t(locale, 'meta.description'),
  url: canonical,
  telephone: site.phone.href,
  email: site.email,
  servesCuisine: site.seo.servesCuisine,
  priceRange: site.seo.priceRange,
  acceptsReservations: site.seo.acceptsReservations,
  // Links the site to the restaurant's official profiles, so search engines
  // treat them as the same entity.
  sameAs: site.social.filter((link) => link.url).map((link) => link.url),
  hasMap: site.mapUrl || undefined,
  address: {
    '@type': 'PostalAddress',
    // Structured data carries one form of the address; the Greek one, since
    // that is the address as it is written locally.
    streetAddress: site.address.street.el,
    addressLocality: site.address.city.el,
    addressRegion: site.address.region.el,
    postalCode: site.address.postalCode,
    addressCountry: site.address.country,
  },
  // Omitted entirely while unknown — emitting null coordinates would be worse
  // than emitting nothing.
  ...(site.geo.latitude !== null && site.geo.longitude !== null
    ? {
        geo: {
          '@type': 'GeoCoordinates',
          latitude: site.geo.latitude,
          longitude: site.geo.longitude,
        },
      }
    : {}),
  openingHoursSpecification: openingHours,
  // A URL rather than an inline graph: schema.org expects hasMenu to point at
  // the menu, and it keeps 14 KB of structured data off every other page.
  hasMenu: menuUrl,
};

/** Emitted only on /menu, where the items actually are. */
const menuGraph = {
  '@context': 'https://schema.org',
  '@type': 'Menu',
  '@id': menuUrl,
  name: t(locale, 'menu.heading'),
  url: menuUrl,
  inLanguage: 'el',
  hasMenuSection: menuSections,
};

const schemas = menuSchema ? [restaurantSchema, menuGraph] : [restaurantSchema];

/* Both dictionaries ship inline. Together they are a few kilobytes — smaller
   than the round trip a fetch would cost, and it means switching language never
   waits on the network. */
const dictJson = JSON.stringify(dictionaries);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Generated from the client's logo by `npm run favicons`. */}
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    {/*
      All four font files are preloaded. This is a deliberate departure from
      "preload only the hero image": measurement showed the page's entire
      layout-shift score came from `font-display: swap` reflowing text as each
      face arrived. The four files are the complete font payload (128 KB) — a
      Greek page shows both scripts above the fold, so none of them is
      speculative, and arriving before first paint removes the shift entirely.
    */}
    <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-greek-wght-normal.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-latin-wght-normal.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/eb-garamond-greek-wght-normal.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/eb-garamond-latin-wght-normal.woff2" crossorigin />

    <title data-i18n={titleKey}>{title}</title>
    <meta name="description" content={description} data-i18n-content={descriptionKey} />

    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="el" href={canonical} />
    <link rel="alternate" hreflang="en" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />

    <meta property="og:type" content="restaurant.restaurant" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} data-i18n-content={titleKey} />
    <meta property="og:description" content={description} data-i18n-content={descriptionKey} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="el_GR" />
    <meta property="og:locale:alternate" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#181414" />

    {schemas.map((schema) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>

  <body>
    <a class="skip-link" href="#main" data-i18n="a11y.skipToContent">{t(locale, 'a11y.skipToContent')}</a>
    <slot />

    <script is:inline type="application/json" id="i18n-dict" set:html={dictJson} />

    <script is:inline>
      /**
       * Language switcher.
       *
       * Greek is server-rendered, so the page is already correct before this
       * runs; this only swaps chrome when the visitor has chosen English. The
       * menu section is marked lang="el" in the markup and is never touched —
       * its content is Greek in both locales.
       */
      (function () {
        var KEY = 'fokia:lang';
        var DEFAULT = 'el';
        var node = document.getElementById('i18n-dict');
        if (!node) return;
        var dict = JSON.parse(node.textContent || '{}');

        function apply(lang) {
          var strings = dict[lang];
          if (!strings) return;

          document.documentElement.lang = lang;

          document.querySelectorAll('[data-i18n]').forEach(function (el) {
            var value = strings[el.getAttribute('data-i18n')];
            if (value != null) el.textContent = value;
          });

          document.querySelectorAll('[data-i18n-content]').forEach(function (el) {
            var value = strings[el.getAttribute('data-i18n-content')];
            if (value != null) el.setAttribute('content', value);
          });

          document.querySelectorAll('[data-i18n-alt]').forEach(function (el) {
            var value = strings[el.getAttribute('data-i18n-alt')];
            if (value != null) el.setAttribute('alt', value);
          });

          document.querySelectorAll('[data-i18n-label]').forEach(function (el) {
            var value = strings[el.getAttribute('data-i18n-label')];
            if (value == null) return;
            // Labels that count something (the carousel dots) carry their number
            // separately, so the translated string keeps its {n} placeholder.
            var n = el.getAttribute('data-i18n-n');
            if (n != null) value = value.replace('{n}', n);
            el.setAttribute('aria-label', value);
          });

          document.querySelectorAll('[data-lang-btn]').forEach(function (btn) {
            btn.setAttribute('aria-pressed', String(btn.getAttribute('data-lang-btn') === lang));
          });

          try {
            localStorage.setItem(KEY, lang);
          } catch (e) {
            /* private mode — the choice simply does not persist */
          }
        }

        var stored;
        try {
          stored = localStorage.getItem(KEY);
        } catch (e) {
          stored = null;
        }
        if (stored && stored !== DEFAULT) apply(stored);

        document.querySelectorAll('[data-lang-btn]').forEach(function (btn) {
          btn.addEventListener('click', function () {
            apply(btn.getAttribute('data-lang-btn'));
          });
        });
      })();
    </script>
  </body>
</html>
